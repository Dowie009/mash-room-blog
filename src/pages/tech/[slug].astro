---
/**
 * /tech/[slug].astro - TECH記事ページ
 *
 * このファイルはデータを取得してPostLayoutに渡すだけ。
 * デザインを変えたい時は PostLayoutMonoJournal.astro を編集してください。
 *
 * レイアウト履歴:
 * - PostLayout.astro: パターンA/B（archive/pattern-ab-backup-2026-02-01 ブランチに保存）
 * - PostLayoutMonoJournal.astro: Mono Journal形式（現在使用中）
 */
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayoutMonoJournal.astro';

// 動的ルート生成
export async function getStaticPaths() {
  const techEntries = await getCollection('tech');
  return techEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<PostLayout frontmatter={entry.data} collection="tech">
  <Content />
</PostLayout>
