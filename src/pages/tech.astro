      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 40px rgba(0, 255, 255, 0.5);
      margin-top: 1rem;
      opacity: 0;
      transform: translateY(20px);
    }
    .intro-glitch-line {
      position: absolute;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #00ffff, #ff00ff, #ffff00, transparent);
      opacity: 0;
      filter: blur(1px);
    }
    .intro-glitch-line.top { top: 30%; }
    .intro-glitch-line.bottom { bottom: 30%; }

    /* キラキラパーティクル */
    .intro-particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: #fff;
      border-radius: 50%;
      opacity: 0;
      filter: blur(1px);
      box-shadow: 0 0 10px #00ffff, 0 0 20px #ff00ff;
