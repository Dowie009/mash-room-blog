---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Content Collectionsから記事データを取得（下書き除外）
const allPosts = await getCollection('tech', ({ data }) => !data.draft);
// 日付でソート（新しい順）
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 日付フォーマット関数
const formatDate = (date: Date) => {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).replace(/\//g, '.');
};

// カテゴリラベル（5カテゴリー）
const categoryLabels: Record<string, string> = {
  'ai-experience': 'AI体験談',
  'ai-tips': 'AI TIPS',
  'dev-tools': '開発ツール',
  'useful-tools': '便利ツール',
  'blog-writing': 'ブログ運営',
};

// カテゴリカラー
const categoryColors: Record<string, string> = {
  'ai-experience': '#00d4ff',
  'ai-tips': '#ffaa00',
  'dev-tools': '#a855f7',
  'useful-tools': '#22c55e',
  'blog-writing': '#f97316',
};

// 記事データをJavaScript形式に変換（heroImageを優先、なければthumbnail）
const articlesData = sortedPosts.map((post, index) => ({
  id: index,
  slug: post.slug,
  title: post.data.title,
  cat: post.data.category,
  catColor: categoryColors[post.data.category] || '#00ffff',
  date: formatDate(post.data.date),
  img: (post.data as any).heroImage || post.data.thumbnail || '/images/og-default.png',
  description: post.data.description || '',
  tags: post.data.tags || [],
}));

// カテゴリ一覧（2つだけ）
const categories = [
  { id: 'ALL', color: '#00ffff', label: 'ALL' },
  { id: 'ai-journey', color: '#00ffff', label: 'AI JOURNEY' },
  { id: 'ai-tips', color: '#ffaa00', label: 'AI TIPS' },
];
---

<Layout title="MASHROOM | TECH LAB">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Zen+Old+Mincho:wght@700;900&family=Space+Grotesk:wght@300;500;700&family=Noto+Sans+JP:wght@300;400;700&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet">

  <!-- LIBRARIES -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/Flip.min.js"></script>
  <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <style is:global>
    /* === GLOBAL VARIABLES === */
    :root {
      --bg-deep: #05020a;
      --text-main: #ffffff;
      --accent-cyan: #00ffff;
      --accent-hot: #ff00ff;
      
      /* Category Colors (Neon) - 新カテゴリー対応 */
      --col-ai-experience: #00d4ff;  /* AI体験談 - シアン */
      --col-ai-tips: #ffaa00;        /* AI TIPS - オレンジ */
      --col-dev-tools: #a855f7;      /* 開発ツール - パープル */
      --col-useful-tools: #22c55e;   /* 便利ツール - グリーン */
      --col-blog-writing: #f97316;   /* ブログ運営 - オレンジレッド */
    }

    body {
      background-color: var(--bg-deep);
      color: var(--text-main);
      font-family: 'Noto Sans JP', sans-serif;
      overflow: hidden;
      margin: 0; padding: 0;
      cursor: none;
    }

    .font-cyber { font-family: 'Orbitron', sans-serif; }
    .font-mincho { font-family: 'Zen Old Mincho', serif; }
    .font-code { font-family: 'Fira Code', monospace; }

    /* --- PERFORMANCE FIXES --- */
    .will-transform { will-change: transform; }
    .will-opacity { will-change: opacity; }

    /* --- 1. BACKGROUND LAYERS --- */
    #video-bg {
      position: fixed; inset: 0; z-index: 0;
      width: 100%; height: 100%; object-fit: cover;
      opacity: 1; pointer-events: none;
      transition: opacity 0.3s;
    }

    .deep-space-overlay {
      position: fixed; inset: 0; z-index: 4; pointer-events: none;
      background: radial-gradient(circle, rgba(0,0,0,0) 0%, rgba(0,0,0,0.15) 100%);
      opacity: 0;
      transition: opacity 2s ease-out;
    }

    .comic-halftone {
      position: fixed; inset: 0; z-index: 5; pointer-events: none;
      background-image: radial-gradient(circle, rgba(0,0,0,0.6) 2px, transparent 2px);
      background-size: 12px 12px; 
      opacity: 0; 
      mix-blend-mode: normal; /* overlayを外して通常表示に */
      transition: opacity 2s ease-out;
    }

    /* --- 2. UI COMPONENTS --- */
    #ui-layer {
      position: fixed; inset: 0; z-index: 100; pointer-events: none;
      padding: 2rem;
      display: flex; flex-direction: column; justify-content: space-between;
    }
    .ai-header { display: flex; justify-content: space-between; align-items: flex-start; pointer-events: auto; }
    .ai-logo {
      font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 1.8rem;
      letter-spacing: 0.1em; color: white; 
      text-shadow: 2px 2px 0px #000;
    }
    .ai-status {
      font-family: 'Fira Code', monospace; font-size: 0.7rem; color: rgba(255,255,255,0.6);
      text-align: right;
    }

    /* --- SCROLL GUIDE --- */
    #scroll-guide {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 120;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.2rem;
      opacity: 0;
      pointer-events: none;
    }
    .scroll-guide-line {
      width: 1px;
      height: 50px;
      background: linear-gradient(180deg, transparent, rgba(192, 192, 176, 0.5));
    }
    .scroll-guide-text {
      font-family: 'Orbitron', sans-serif;
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      display: flex;
      gap: 0;
    }
    .scroll-guide-text .sg-char {
      display: inline-block;
      text-shadow: none;
    }
    .scroll-guide-text .sg-space {
      width: 0.5em;
    }
    .scroll-guide-chevrons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .scroll-chevron {
      width: 40px;
      height: 18px;
      color: rgba(0, 212, 255, 0.5);
      animation: chevron-pulse 1.8s ease-in-out infinite;
    }
    .scroll-chevron:nth-child(1) { animation-delay: 0s; }
    .scroll-chevron:nth-child(2) { animation-delay: 0.2s; }
    .scroll-chevron:nth-child(3) { animation-delay: 0.4s; }

    @keyframes chevron-pulse {
      0%, 100% { opacity: 0.15; transform: translateY(0); }
      50% { opacity: 1; transform: translateY(5px); }
    }

    /* HUD Buttons */
    .hud-container {
      position: absolute; bottom: 1.2rem; left: 50%; transform: translateX(-50%);
      z-index: 110; pointer-events: auto;
      display: flex; gap: 12px; align-items: flex-end;
    }

    /* === サイバーアーケードボタン === */
    .hud-btn {
      --btn-color: #0ff;
      --btn-dark: #066;
      position: relative;
      width: 110px; height: 110px;
      border: 0.5px solid color-mix(in srgb, var(--btn-color) 50%, transparent);
      border-radius: 50%;
      color: #fff;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      cursor: pointer;
      padding: 0;
      gap: 2px;
      background: radial-gradient(circle at 40% 35%, rgba(255,255,255,0.08), transparent 60%),
                  radial-gradient(circle at 50% 50%, var(--btn-dark), #0a0a1a 80%);
      box-shadow:
        0 6px 0 rgba(0,0,0,0.6),
        0 0 4px color-mix(in srgb, var(--btn-color) 20%, transparent),
        inset 0 0 6px color-mix(in srgb, var(--btn-color) 8%, transparent);
      transition: transform 0.1s, box-shadow 0.15s, border-color 0.15s;
      overflow: hidden;
    }
    /* 光が左→右に走るスキャンライン */
    .hud-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--btn-color) 25%, transparent), transparent);
      pointer-events: none;
      z-index: 2;
      animation: none;
    }
    /* 上面のハイライト */
    .hud-btn::after {
      content: '';
      position: absolute;
      top: 8px; left: 20%; right: 20%;
      height: 20px;
      border-radius: 50%;
      background: linear-gradient(180deg, rgba(255,255,255,0.2), transparent);
      pointer-events: none;
    }
    /* 光走査アニメーション — 各ボタンを時間差で */
    @keyframes btn-scan {
      0%, 85% { left: -50%; opacity: 0; }
      90% { opacity: 1; }
      100% { left: 120%; opacity: 0; }
    }
    .hud-btn:nth-child(2)::before { animation: btn-scan 4.0s ease-in-out 0.0s infinite; }
    .hud-btn:nth-child(3)::before { animation: btn-scan 4.5s ease-in-out 0.3s infinite; }
    .hud-btn:nth-child(4)::before { animation: btn-scan 5.0s ease-in-out 0.6s infinite; }
    .hud-btn:nth-child(5)::before { animation: btn-scan 4.2s ease-in-out 0.9s infinite; }
    .hud-btn:nth-child(6)::before { animation: btn-scan 4.8s ease-in-out 1.2s infinite; }
    .hud-btn:nth-child(7)::before { animation: btn-scan 4.3s ease-in-out 1.5s infinite; }

    .hud-btn-icon {
      flex-shrink: 0;
      filter: none;
      z-index: 1;
    }
    .hud-btn-label {
      font-family: 'Orbitron', 'Fira Code', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      white-space: nowrap;
      z-index: 1;
      text-shadow: none;
    }
    .hud-btn-count {
      font-family: 'Orbitron', monospace;
      font-size: 0.6rem;
      font-weight: 400;
      color: color-mix(in srgb, var(--btn-color) 80%, white);
      z-index: 1;
      text-shadow: none;
    }
    /* ホバー：ネオン強化 */
    .hud-btn:hover {
      transform: translateY(2px);
      border-color: var(--btn-color);
      box-shadow:
        0 4px 0 rgba(0,0,0,0.5),
        0 0 8px color-mix(in srgb, var(--btn-color) 35%, transparent),
        inset 0 0 10px color-mix(in srgb, var(--btn-color) 12%, transparent);
    }
    .hud-btn:hover .hud-btn-icon {
      filter: none;
    }
    .hud-btn:active {
      transform: translateY(5px);
      box-shadow:
        0 1px 0 rgba(0,0,0,0.4),
        0 0 8px color-mix(in srgb, var(--btn-color) 40%, transparent),
        inset 0 0 10px color-mix(in srgb, var(--btn-color) 15%, transparent);
    }
    .hud-btn.active {
      border-color: var(--btn-color);
      box-shadow:
        0 6px 0 rgba(0,0,0,0.6),
        0 0 12px color-mix(in srgb, var(--btn-color) 50%, transparent),
        inset 0 0 18px color-mix(in srgb, var(--btn-color) 20%, transparent);
    }

    /* --- DATABASE ボタン（左下独立配置） --- */
    .db-btn {
      position: absolute;
      bottom: 1.5rem;
      left: 1.5rem;
      z-index: 110;
      pointer-events: auto;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 44px 18px 28px;
      background: rgba(10, 10, 20, 0.85);
      border: 0.5px solid rgba(34, 211, 238, 0.4);
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 4px rgba(34, 211, 238, 0.1), inset 0 0 4px rgba(34, 211, 238, 0.04);
    }
    .db-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.2), transparent);
      pointer-events: none;
      animation: db-scan 5s ease-in-out 2s infinite;
    }
    @keyframes db-scan {
      0%, 80% { left: -50%; opacity: 0; }
      88% { opacity: 1; }
      100% { left: 120%; opacity: 0; }
    }
    .db-btn:hover {
      border-color: rgba(34, 211, 238, 0.8);
      box-shadow: 0 0 6px rgba(34, 211, 238, 0.15), inset 0 0 6px rgba(34, 211, 238, 0.06);
    }
    .db-btn:active {
      transform: scale(0.97);
    }
    .db-btn-icon {
      color: #22d3ee;
      filter: none;
      flex-shrink: 0;
    }
    .db-btn-label {
      font-family: 'Orbitron', 'Fira Code', monospace;
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: #22d3ee;
    }
    @media (max-width: 1200px) {
      .db-btn { display: none; }
    }

    /* --- ALL --- シアン */
    .hud-btn[data-cat="ALL"] {
      --btn-color: #22d3ee;
      --btn-dark: #0c4a54;
    }

    /* --- AI体験談 --- ピンク */
    .hud-btn[data-cat="ai-experience"] {
      --btn-color: #f472b6;
      --btn-dark: #4a1038;
    }

    /* --- AI TIPS --- イエロー/アンバー */
    .hud-btn[data-cat="ai-tips"] {
      --btn-color: #fbbf24;
      --btn-dark: #4a3008;
    }

    /* --- 開発ツール --- パープル */
    .hud-btn[data-cat="dev-tools"] {
      --btn-color: #a78bfa;
      --btn-dark: #2e1065;
    }

    /* --- 便利ツール --- グリーン */
    .hud-btn[data-cat="useful-tools"] {
      --btn-color: #34d399;
      --btn-dark: #064e3b;
    }

    /* --- ブログ運営 --- オレンジ */
    .hud-btn[data-cat="blog-writing"] {
      --btn-color: #fb923c;
      --btn-dark: #4a1c06;
    }

    /* --- 3. 3D & CARD STYLES --- */
    #tunnel-scene {
      position: fixed; inset: 0; perspective: 800px; overflow: hidden;
      z-index: 10;
    }
    
    /* ランダム整列時のみスクロール可能 */
    #tunnel-scene.random-arrange-mode {
      overflow-y: auto;
      overflow-x: hidden;
    }
    #tunnel-world {
      position: absolute; width: 100%; min-height: 100%;
      transform-style: preserve-3d;
    }
    
    /* Category Neon Colors */
    .ai-card-3d[data-cat="ai-experience"] { --neon: var(--col-ai-experience); }
    .ai-card-3d[data-cat="ai-tips"] { --neon: var(--col-ai-tips); }
    .ai-card-3d[data-cat="dev-tools"] { --neon: var(--col-dev-tools); }
    .ai-card-3d[data-cat="useful-tools"] { --neon: var(--col-useful-tools); }
    .ai-card-3d[data-cat="blog-writing"] { --neon: var(--col-blog-writing); }
    
    .ai-card-3d {
      position: absolute;
      width: 260px; height: 340px;
      left: 50%; top: 50%;
      margin-left: -130px; margin-top: -170px;
      
      background: rgba(10, 10, 15, 0.8);
      backdrop-filter: blur(8px);
      border: 0.5px solid rgba(168, 85, 247, 0.4);
      border-radius: 4px;
      
      transform-style: preserve-3d;
      cursor: pointer;
      
      will-change: transform, opacity; 
      
      opacity: 0.4;
      filter: grayscale(100%);
      transition: opacity 0.3s, filter 0.3s, box-shadow 0.3s;
    }
    
    /* SVG border animation */
    .card-border-animated {
      opacity: 1;
    }
    
    .border-stroke {
      animation: rotate-border-svg 2s linear infinite;
    }
    
    @keyframes rotate-border-svg {
      0% { 
        stroke-dashoffset: 0; 
      }
      100% { 
        stroke-dashoffset: 1200; 
      }
    }
    
    .ai-card-3d.active-zone {
      opacity: 1;
      filter: grayscale(0%);
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    }
    
    .ai-card-3d:hover {
      opacity: 1;
      filter: grayscale(0%) brightness(1.2);
      border-color: var(--neon, var(--accent-cyan));
      z-index: 1000;
      box-shadow: 0 0 30px var(--neon, var(--accent-cyan)), 
                  inset 0 0 20px rgba(255, 255, 255, 0.1);
    }
    
    .ai-card-3d:hover::before {
      opacity: 1;
    }

    .ai-card-3d.formation-mode { 
      opacity: 1 !important; 
      filter: grayscale(0%) !important;
      box-shadow: 0 0 25px var(--neon, currentColor) !important;
    }
    
    /* ワンちゃんモード：カードを大きく */
    #tunnel-scene.random-arrange-mode .ai-card-3d.formation-mode {
      width: 400px !important;
      height: 520px !important;
    }
    
    #tunnel-scene.random-arrange-mode .ai-card-3d.formation-mode .ai-card-img {
      width: 100%;
      height: 280px;
      object-fit: cover;
    }
    
    #tunnel-scene.random-arrange-mode .ai-card-3d.formation-mode .ai-card-title {
      font-size: 1.4rem;
      line-height: 1.4;
    }
    
    #tunnel-scene.random-arrange-mode .ai-card-3d.formation-mode .ai-card-category {
      font-size: 0.9rem;
      padding: 6px 12px;
    }
    
    #tunnel-scene.random-arrange-mode .ai-card-3d.formation-mode .ai-card-date {
      font-size: 0.85rem;
    }

    .ai-card-inner {
      position: absolute; inset: 2px;
      display: flex; flex-direction: column; 
      background: #000;
      overflow: hidden; pointer-events: none;
    }
    .ai-card-img {
      width: 100%; height: 60%; object-fit: cover;
      border-bottom: 2px solid; /* カテゴリー色が動的に適用される */
      filter: grayscale(100%);
      transition: filter 0.3s;
    }
    .ai-card-3d:hover .ai-card-img {
      filter: grayscale(0%);
    }
    .ai-card-3d.active-zone .ai-card-img {
      filter: grayscale(0%);
    }
    .ai-card-info { 
      padding: 1rem; color: white; flex-grow: 1; 
      display: flex; flex-direction: column;
    }
    .ai-card-title {
      font-family: 'Zen Old Mincho', serif; font-size: 1rem; margin-bottom: 0.5rem;
      line-height: 1.5; font-weight: 900;
    }
    .ai-card-meta {
      font-family: 'Fira Code', monospace; font-size: 0.6rem; 
      display: flex; justify-content: space-between; margin-bottom: 0.5rem;
      font-weight: bold;
    }
    .ai-card-meta-category {
      /* カテゴリー色が動的に適用される */
    }

    /* --- 4. FLOATING ASSETS --- */
    .floater-container {
      position: fixed; inset: 0; z-index: 20; pointer-events: none; overflow: hidden;
    }
    .floater {
      position: absolute; will-change: transform; pointer-events: auto; cursor: pointer;
      filter: drop-shadow(4px 4px 0px rgba(0,0,0,0.8));
    }
    .floater:hover { transform: scale(1.1); filter: drop-shadow(0 0 10px white); z-index: 100; }

    /* --- 5. CURSOR --- */
    * {
      cursor: none !important;
    }

    #fighter-cursor {
      position: fixed;
      top: 0;
      left: 0;
      width: 50px;
      height: 50px;
      pointer-events: none;
      z-index: 99999;
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
      filter: drop-shadow(0 0 4px cyan);
      opacity: 0;
      will-change: transform;
    }

    #fighter-svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: #00ffff;
      stroke-width: 2.5;
      overflow: visible;
      transform-origin: center center;
    }

    #reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 70px;
      height: 70px;
      border: 2px dashed rgba(255, 255, 255, 0.6);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      animation: spin 4s linear infinite;
      pointer-events: none;
    }

    @keyframes spin {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }

    /* スマホなどタッチデバイスでは通常カーソル */
    @media (hover: none) {
      * {
        cursor: auto !important;
      }
      #fighter-cursor {
        display: none !important;
      }
    }

    /* ARCHIVE.GRIDモード時は丸カーソルを表示 */
    body.archive-mode #fighter-cursor {
      display: none !important;
    }
    body.archive-mode #archive-cursor {
      display: block !important;
    }

    /* ARCHIVE.GRID用の丸カーソル（軽量版） */
    #archive-cursor {
      position: fixed;
      top: 0;
      left: 0;
      pointer-events: none;
      z-index: 99999;
      display: none;
      will-change: transform;
    }

    #archive-cursor-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #00ffff;
      transform: translate(-50%, -50%);
      /* box-shadow と transition 削除（重い） */
    }

    #archive-cursor.hovering #archive-cursor-dot {
      transform: translate(-50%, -50%) scale(1.5);
      background: #ff00ff;
    }

    /* --- 6. LIST VIEW --- */
    #list-view-container {
      position: fixed; inset: 0; z-index: 200;
      background: #05020a;
      padding: 6rem 2rem;
      display: none; opacity: 0;
      overflow-y: auto;
    }
    
    /* --- 7. ARCHIVE GRID VIEW (軽量化版) --- */
    #archive-grid-container {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(5, 2, 10, 0.98); /* blur削除、不透明度を上げる */
      padding: 6rem 2rem;
      display: none; opacity: 0;
      overflow-y: auto;
    }
    .archive-grid {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
      padding: 2rem 0;
    }
    .archive-card {
      background: rgba(10, 10, 15, 0.95); /* blur削除 */
      border: 0.5px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s ease-out, border-color 0.2s ease-out; /* 軽量化 */
      display: flex;
      flex-direction: column;
      will-change: transform; /* GPU最適化 */
    }
    .archive-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent-cyan);
      /* box-shadow削除（重い） */
    }
    .archive-card-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-bottom: 2px solid;
    }
    .archive-card-info {
      padding: 1.5rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .archive-card-meta {
      font-family: 'Fira Code', monospace;
      font-size: 0.7rem;
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.8rem;
      align-items: center;
    }
    .archive-card-category {
      font-weight: 600;
      padding: 4px 8px;
      border: 1px solid currentColor;
      border-radius: 4px;
    }
    .archive-card-title {
      font-family: 'Zen Old Mincho', serif;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.5;
      margin-bottom: 0.5rem;
    }
    .archive-card-date {
      font-family: 'Fira Code', monospace;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.6);
      margin-top: auto;
    }

    /* --- LATEST ARTICLES WIDGET (タブ切り替え版・差別化デザイン) --- */
    #latest-widget {
      position: fixed;
      top: 173px;
      right: 2rem;
      z-index: 150;
      width: 340px;
      background: linear-gradient(135deg, rgba(30, 35, 45, 0.98) 0%, rgba(20, 25, 35, 0.98) 100%);
      backdrop-filter: blur(20px);
      border-radius: 16px;
      border: 1px solid rgba(100, 200, 255, 0.15);
      box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(100, 200, 255, 0.05) inset,
        0 1px 0 rgba(255, 255, 255, 0.05) inset;
      overflow: hidden;
      opacity: 0;
      pointer-events: auto;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    #latest-widget.collapsed {
      transform: translateX(calc(100% + 1rem));
    }
    .widget-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 1rem;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
      z-index: 210;
      pointer-events: auto;
    }
    /* タブUI */
    .widget-tabs {
      display: flex;
      gap: 0.3rem;
      background: rgba(0, 0, 0, 0.3);
      padding: 4px;
      border-radius: 10px;
    }
    .widget-tab {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1.1rem;
      background: transparent;
      border: none;
      border-radius: 8px;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      cursor: pointer !important;
      transition: all 0.2s ease;
      position: relative;
      z-index: 200;
      pointer-events: auto;
    }
    .widget-tab:hover {
      color: rgba(255, 255, 255, 0.8);
    }
    .widget-tab.active {
      background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
      color: white;
      box-shadow: 0 2px 8px rgba(0, 212, 255, 0.3);
    }
    .widget-tab i {
      width: 14px;
      height: 14px;
    }
    .widget-content.hidden {
      display: none;
    }
    .widget-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      padding: 4px;
      border-radius: 4px;
      transition: color 0.2s, background 0.2s;
    }
    .widget-close:hover {
      color: white;
      background: rgba(255, 255, 255, 0.1);
    }
    .widget-content {
      padding: 0.8rem;
      max-height: 580px;
      overflow-y: auto;
    }
    .widget-article {
      display: flex;
      gap: 0.8rem;
      padding: 0.8rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      color: inherit;
    }
    .widget-article:hover {
      background: rgba(255, 255, 255, 0.08);
    }
    .widget-article-thumb {
      width: 60px;
      height: 60px;
      border-radius: 6px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .widget-article-info {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .widget-article-title {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0.3rem;
    }
    .widget-article-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
    }
    .widget-article-category {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 500;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.1);
    }
    .widget-article-date {
      color: rgba(255, 255, 255, 0.5);
      font-family: 'Fira Code', monospace;
    }

    /* & more ボタン */
    .widget-more {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.7rem 1rem;
      background: linear-gradient(180deg, rgba(0, 212, 255, 0.05) 0%, rgba(0, 212, 255, 0.12) 100%);
      border: none;
      border-top: 1px solid rgba(0, 212, 255, 0.15);
      color: rgba(0, 212, 255, 0.85);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .widget-more:hover {
      background: linear-gradient(180deg, rgba(0, 212, 255, 0.1) 0%, rgba(0, 212, 255, 0.2) 100%);
      color: #00d4ff;
    }
    .widget-more i {
      width: 14px;
      height: 14px;
    }

    /* Toggle button */
    #widget-toggle {
      position: fixed;
      bottom: 2rem;
      right: 1rem;
      z-index: 149;
      width: 40px;
      height: 40px;
      background: rgba(30, 30, 35, 0.9);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      color: rgba(255, 255, 255, 0.7);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      opacity: 0;
      pointer-events: none;
    }
    #widget-toggle.show {
      opacity: 1;
      pointer-events: auto;
    }
    #widget-toggle:hover {
      background: rgba(50, 50, 55, 0.95);
      border-color: rgba(255, 255, 255, 0.4);
      color: white;
    }

    /* === CATEGORY SIDEBAR (回遊ナビ・見やすいデザイン) === */
    #category-sidebar {
      position: fixed;
      left: 1.5rem;
      top: 173px;
      z-index: 150;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      pointer-events: auto;
      background: linear-gradient(160deg, rgba(15, 20, 30, 0.95) 0%, rgba(10, 15, 25, 0.98) 100%);
      padding: 0.9rem;
      border-radius: 16px;
      border: 1px solid rgba(100, 150, 255, 0.2);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.4),
        0 0 0 1px rgba(100, 150, 255, 0.1) inset;
      backdrop-filter: blur(20px);
      min-width: 150px;
      max-height: 70vh;
      overflow-y: auto;
    }

    /* 回遊リンクセクション */
    .sidebar-nav-section {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .sidebar-nav-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.7rem;
      border-radius: 8px;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.85);
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      transition: all 0.2s ease;
      cursor: pointer !important;
    }

    .sidebar-nav-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
      transform: translateX(3px);
    }

    .sidebar-nav-link i {
      color: rgba(255, 255, 255, 0.5);
    }

    /* チャプターセクション */
    .sidebar-chapters {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .sidebar-chapter-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 0.7rem;
      border-radius: 8px;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.7);
      transition: all 0.2s ease;
      cursor: pointer !important;
      background: rgba(255, 255, 255, 0.03);
    }

    .sidebar-chapter-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
    }

    .sidebar-chapter-link.active {
      background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 150, 200, 0.08) 100%);
      color: #00d4ff;
      border-left: 3px solid #00d4ff;
    }

    .chapter-num {
      font-family: 'Fira Code', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.35);
      min-width: 1.5rem;
    }

    .sidebar-chapter-link.active .chapter-num {
      color: #00d4ff;
    }

    .chapter-info {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      flex: 1;
    }

    .chapter-name {
      font-family: 'Fira Code', monospace;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .chapter-desc {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.6rem;
      color: rgba(255, 255, 255, 0.45);
    }

    .sidebar-chapter-link.active .chapter-desc {
      color: rgba(0, 212, 255, 0.6);
    }

    .chapter-action {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.6rem;
      color: rgba(255, 255, 255, 0.4);
      white-space: nowrap;
    }

    .chapter-action.current {
      color: #00d4ff;
      font-weight: 500;
    }

    .sidebar-chapter-link:hover .chapter-action {
      color: rgba(255, 255, 255, 0.7);
    }

    /* カテゴリフィルターセクション */
    .sidebar-filter-section {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .sidebar-filter-title {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 0.4rem;
    }

    .sidebar-filter-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 1rem;
      border-radius: 10px;
      cursor: pointer !important;
      transition: all 0.2s ease;
      color: rgba(255, 255, 255, 0.8);
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1rem;
      font-weight: 500;
    }

    .sidebar-filter-item:hover {
      background: rgba(255, 255, 255, 0.08);
      color: white;
    }

    .sidebar-filter-item.active {
      background: rgba(0, 212, 255, 0.15);
      color: #00d4ff;
    }

    .sidebar-filter-item[data-cat="ai-experience"].active {
      background: rgba(0, 212, 255, 0.15);
      color: #00d4ff;
    }

    .sidebar-filter-item[data-cat="ai-tips"].active {
      background: rgba(255, 170, 0, 0.15);
      color: #ffaa00;
    }

    .sidebar-filter-item[data-cat="dev-tools"].active {
      background: rgba(168, 85, 247, 0.15);
      color: #a855f7;
    }

    .sidebar-filter-item[data-cat="useful-tools"].active {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }

    .sidebar-filter-item[data-cat="blog-writing"].active {
      background: rgba(249, 115, 22, 0.15);
      color: #f97316;
    }

    .filter-icon {
      font-size: 1.2rem;
    }

    .sidebar-count {
      margin-left: auto;
      font-family: 'Fira Code', monospace;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.4);
      background: rgba(0, 0, 0, 0.3);
      padding: 3px 10px;
      border-radius: 12px;
    }

    /* AI Journey Hubリンク */
    .sidebar-hub-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 0.8rem;
      margin-top: 0.4rem;
      border-radius: 10px;
      text-decoration: none;
      background: linear-gradient(135deg, rgba(138, 100, 255, 0.2) 0%, rgba(100, 70, 200, 0.15) 100%);
      border: 1px solid rgba(138, 100, 255, 0.3);
      color: #a78bfa;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      transition: all 0.2s ease;
      cursor: pointer !important;
    }

    .sidebar-hub-link:hover {
      background: linear-gradient(135deg, rgba(138, 100, 255, 0.3) 0%, rgba(100, 70, 200, 0.25) 100%);
      border-color: rgba(138, 100, 255, 0.5);
      transform: translateX(3px);
    }

    .sidebar-hub-link i:last-child {
      margin-left: auto;
    }

    /* === SIDEBAR HOVER PREVIEW === */
    #sidebar-preview {
      position: fixed;
      z-index: 160;
      pointer-events: none;
      opacity: 0;
      transform: translateX(-10px) scale(0.96);
      transition: opacity 0.25s ease, transform 0.25s ease;
      will-change: opacity, transform;
    }
    #sidebar-preview.visible {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    .sidebar-preview-arrow {
      position: absolute;
      left: -8px;
      top: 24px;
      width: 0; height: 0;
      border-top: 10px solid transparent;
      border-bottom: 10px solid transparent;
      border-right: 10px solid rgba(0, 212, 255, 0.4);
      filter: drop-shadow(-2px 0 4px rgba(0, 212, 255, 0.3));
    }
    .sidebar-preview-inner {
      position: relative;
      width: 420px;
      aspect-ratio: 16 / 10;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(0, 212, 255, 0.3);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.6),
        0 0 20px rgba(0, 212, 255, 0.15),
        0 0 0 1px rgba(0, 212, 255, 0.1) inset;
      background: rgba(10, 15, 25, 0.95);
    }
    #sidebar-preview-img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .sidebar-preview-scanline {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        0deg, transparent, transparent 2px,
        rgba(0, 212, 255, 0.03) 2px, rgba(0, 212, 255, 0.03) 4px
      );
      pointer-events: none;
      mix-blend-mode: overlay;
    }
    .sidebar-preview-label {
      margin-top: 6px;
      padding: 4px 10px;
      font-family: 'Fira Code', monospace;
      font-size: 0.65rem;
      color: rgba(0, 212, 255, 0.8);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
    }

    /* レスポンシブ対応 */
    @media (max-width: 1200px) {
      #category-sidebar, #sidebar-preview {
        display: none;
      }
    }

    @media (max-width: 768px) {
      #latest-widget {
        display: none;
      }
      #widget-toggle {
        display: none;
      }
    }

    .list-header {
      max-width: 1000px; margin: 0 auto 3rem; border-bottom: 2px solid #333;
      padding-bottom: 1rem; display: flex; justify-content: space-between; align-items: end;
    }
    .list-row {
      display: grid; grid-template-columns: 120px 1fr 100px; gap: 2rem;
      padding: 1.5rem 1rem; border-bottom: 1px solid #222;
      cursor: pointer; transition: background 0.2s; color: #999;
      align-items: center; max-width: 1000px; margin: 0 auto;
    }
    .list-row:hover {
      background: #111; color: white;
    }
    .list-row[data-cat="ai-experience"]:hover { border-left: 4px solid var(--col-ai-experience); }
    .list-row[data-cat="ai-tips"]:hover { border-left: 4px solid var(--col-ai-tips); }
    .list-row[data-cat="dev-tools"]:hover { border-left: 4px solid var(--col-dev-tools); }
    .list-row[data-cat="useful-tools"]:hover { border-left: 4px solid var(--col-useful-tools); }
    .list-row[data-cat="blog-writing"]:hover { border-left: 4px solid var(--col-blog-writing); }
    .list-date { font-family: 'Fira Code', monospace; font-size: 0.8rem; }
    .list-title { font-family: 'Zen Old Mincho', serif; font-size: 1.2rem; font-weight: 700; }
    .list-cat { 
      font-family: 'Orbitron', sans-serif; font-size: 0.7rem; 
      border: 1px solid currentColor; padding: 4px 8px; text-align: center;
    }

    /* Scroll hint */
    .scroll-hint {
      position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%);
      text-align: center; color: var(--accent-cyan); font-family: 'Fira Code', monospace;
      font-size: 0.75rem; opacity: 0.7; z-index: 101; pointer-events: none;
    }
    
    /* デバッグ情報表示 */
    #debug-info {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: rgba(0, 0, 0, 0.9);
      border: 2px solid #00ffff;
      border-radius: 8px;
      padding: 1rem;
      font-family: 'Courier New', monospace;
      font-size: 0.75rem;
      color: #00ffff;
      z-index: 100000;
      min-width: 250px;
      display: none;
    }
    #debug-info.show {
      display: block;
    }
    #debug-info .debug-item {
      margin: 0.25rem 0;
      padding: 0.25rem;
      border-bottom: 1px solid rgba(0, 255, 255, 0.2);
    }
    #debug-info .debug-item:last-child {
      border-bottom: none;
    }
    #debug-info .debug-label {
      color: #ffff00;
      font-weight: bold;
    }
    #debug-info .debug-value {
      color: #00ff00;
    }
    #debug-info .debug-warning {
      color: #ff6600;
    }
    #debug-info .debug-error {
      color: #ff0000;
    }
    
    /* Coordinate display */
    #coordinate-display {
      position: fixed; top: 2rem; right: 2rem; z-index: 102;
      background: rgba(0, 0, 0, 0.8); border: 2px solid var(--accent-cyan);
      padding: 0.8rem 1.2rem; border-radius: 8px;
      font-family: 'Fira Code', monospace; font-size: 0.9rem;
      color: var(--accent-cyan); pointer-events: none;
      box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
      min-width: 180px;
    }
    #coordinate-display .coord-label {
      color: rgba(255, 255, 255, 0.6); font-size: 0.7rem; margin-bottom: 0.3rem;
    }
    #coordinate-display .coord-value {
      color: var(--accent-cyan); font-weight: 600; letter-spacing: 0.1em;
    }
    #coordinate-display .version-info {
      margin-top: 0.8rem;
      padding-top: 0.8rem;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.4);
      text-align: center;
    }
    
    /* Tooltip bubble - positioned near the dog in lower left */
    #coordinate-tooltip {
      position: fixed;
      bottom: calc(1.5rem + 75px);
      left: 1.5rem;
      z-index: 102;
      background: rgba(0, 0, 0, 0.9);
      padding: 1rem 1.5rem; border-radius: 8px;
      font-family: 'Fira Code', monospace; font-size: 0.85rem;
      pointer-events: auto;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
      max-width: 250px;
      opacity: 1;
      cursor: pointer;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    #coordinate-tooltip::before {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 8px;
      padding: 2px;
      background: linear-gradient(135deg, #ffffff, #ffff00);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      z-index: -1;
    }
    #coordinate-tooltip:hover {
      background: rgba(0, 0, 0, 0.95);
      box-shadow: 0 0 20px rgba(255, 255, 0, 0.5);
    }
    #coordinate-tooltip::after {
      display: none;
    }
    #coordinate-tooltip .tooltip-text {
      background: linear-gradient(135deg, #ffffff, #ffff00);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.6;
      text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      opacity: 1;
      /* ドット文字風の効果 */
      text-rendering: optimizeSpeed;
      -webkit-font-smoothing: none;
      -moz-osx-font-smoothing: unset;
      image-rendering: pixelated;
    }

    /* ===== INTRO TITLE ANIMATION ===== */
    #intro-title-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
