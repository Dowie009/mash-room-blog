  }

  .widget-title-dark {
    font-family: 'Zen Old Mincho', serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }

  .widget-desc-dark {
    font-size: 0.75rem;
