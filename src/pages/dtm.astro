  .filter-nav {
    z-index: 50;
  }
  
  /* pos-topの時だけtransitionを有効化 */
  .filter-nav.pos-top { 
    width: 100%; 
    padding: 2rem 0; 
    background: transparent;
    transition: opacity 0.3s ease;
  }
  
  /* pos-sideの時はtransitionなし（GSAPで制御） */
