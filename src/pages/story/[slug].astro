---
/**
 * /story/[slug].astro - のけ物語 個別エピソードページ
 * noke-posts.js からデータを読み込み、SEO対応の個別ページを生成
 * デザイン: 和紙×文庫本風
 */
import Layout from '../../layouts/Layout.astro';
import { POSTS } from '../../data/noke-posts.js';
import ScoutCTA from '../../components/ScoutCTA.astro';

export function getStaticPaths() {
  // slug生成ヘルパー（getStaticPaths内に定義しないとAstroコンパイラのスコープ分割で参照できない）
  const slugMap: Record<number, string> = {
    31: 'prologue',
    36: 'chapter-01',
    39: 'chapter-02',
    42: 'chapter-03',
    44: 'chapter-04',
    48: 'chapter-05',
    58: 'chapter-06',
    62: 'chapter-07',
    73: 'chapter-08',
    75: 'chapter-09',
    81: 'chapter-10',
    84: 'chapter-11',
  };
  function toSlug(post: { id: number; chapter: number }) {
    return slugMap[post.id] || `chapter-${String(post.chapter).padStart(2, '0')}`;
  }

  return POSTS.map(post => ({
    params: { slug: toSlug(post) },
    props: { post },
  }));
}

// ページ内でも使うslugヘルパー
function toSlug(post: { id: number; chapter: number }) {
  const slugMap: Record<number, string> = {
    31: 'prologue',
    36: 'chapter-01',
    39: 'chapter-02',
    42: 'chapter-03',
    44: 'chapter-04',
    48: 'chapter-05',
    58: 'chapter-06',
    62: 'chapter-07',
    73: 'chapter-08',
    75: 'chapter-09',
    81: 'chapter-10',
    84: 'chapter-11',
  };
  return slugMap[post.id] || `chapter-${String(post.chapter).padStart(2, '0')}`;
}

const { post } = Astro.props;

// 前後のエピソードを取得
const currentIndex = POSTS.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? POSTS[currentIndex - 1] : null;
const nextPost = currentIndex < POSTS.length - 1 ? POSTS[currentIndex + 1] : null;

// 読了時間を計算
const textContent = post.content.replace(/<[^>]+>/g, '');
const readTime = Math.max(1, Math.ceil(textContent.length / 500));

// chapter表示
const chapterLabel = post.chapter === 0 ? 'プロローグ' : `第${post.chapter}話`;
---

<Layout
  title={`${post.title} | のけ物語 - STORY LAB`}
  description={post.excerpt || `のけ物語 ${chapterLabel} - ${post.title}`}
>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Zen+Old+Mincho:wght@400;600;700;900&family=Klee+One:wght@400;600&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">

  <div class="story-page">
    <!-- 和紙テクスチャ背景 -->
    <div class="paper-texture"></div>

    <!-- ヘッダー -->
    <header class="header">
      <div class="header-content">
        <a href="/story" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          のけ物語
        </a>
        <div class="lab-badge">STORY LAB</div>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="main">
      <article class="article-wrapper">
        <!-- ヒーロー -->
        <header class="article-header">
          <div class="chapter-number">{chapterLabel}</div>
          <h1 class="article-title">{post.title}</h1>
          <div class="meta-line">
            <span class="read-time">{readTime}分で読める</span>
            {post.audioLength && (
              <span class="audio-badge">♪ {post.audioLength}</span>
            )}
          </div>
          {post.excerpt && (
            <p class="article-excerpt">{post.excerpt}</p>
          )}
        </header>

        <!-- サムネイル -->
        {post.image && (
          <div class="thumbnail-wrapper">
            <img src={post.image} alt={post.title} class="thumbnail" />
            {post.caption && (
              <p class="thumbnail-caption">{post.caption}</p>
            )}
          </div>
        )}

        <!-- 本文 -->
        <div class="article-content" set:html={post.content} />

        <ScoutCTA />

        <!-- リーダーへのリンク -->
        <div class="reader-link-wrapper">
          <a href="/story" class="reader-link">
            📖 縦書きリーダーで読む
          </a>
        </div>

        <!-- 前後ナビ -->
        <nav class="episode-nav">
          {prevPost ? (
            <a href={`/story/${toSlug(prevPost)}`} class="nav-link nav-prev">
              <span class="nav-direction">← 前の話</span>
              <span class="nav-title">{prevPost.title}</span>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/story/${toSlug(nextPost)}`} class="nav-link nav-next">
              <span class="nav-direction">次の話 →</span>
              <span class="nav-title">{nextPost.title}</span>
            </a>
          ) : <div />}
        </nav>

        <!-- フッター -->
        <footer class="article-footer">
          <a href="/story" class="back-button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            のけ物語トップに戻る
          </a>
          <div class="footer-brand">
            <span>🍄</span>
            <span>きのこ式AI栽培日記</span>
          </div>
        </footer>
      </article>
    </main>
  </div>
</Layout>

<style>
  /* =====================================================
     のけ物語 - 和紙×文庫本風デザイン
     STORY LAB Episode Page
     ===================================================== */

  :root {
    --paper-bg: #f7f4eb;
    --ink-color: #2b2321;
    --accent-color: #8c3a26;
    --sub-color: #a89f91;
    --line-color: #e6e2d8;
  }

  .story-page {
    min-height: 100vh;
    background: var(--paper-bg);
    position: relative;
    font-family: 'Shippori Mincho', serif;
  }

  .paper-texture {
    position: fixed;
    inset: 0;
    background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png");
    opacity: 0.6;
    pointer-events: none;
    z-index: 0;
  }

  /* ヘッダー */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 244, 235, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-color);
  }

  .header-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sub-color);
    text-decoration: none;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .lab-badge {
    background: var(--accent-color);
    color: #f7f4eb;
    padding: 0.35rem 0.9rem;
    border-radius: 2px;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  /* メイン */
  .main {
    position: relative;
    z-index: 1;
  }

  .article-wrapper {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ヒーロー */
  .article-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .chapter-number {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--accent-color);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .article-title {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 900;
    line-height: 1.5;
    color: var(--ink-color);
    margin-bottom: 1.2rem;
    letter-spacing: 0.05em;
  }

  .meta-line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1rem;
  }

  .read-time {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    color: var(--sub-color);
  }

  .audio-badge {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.7rem;
    color: var(--accent-color);
    background: rgba(140, 58, 38, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }

  .article-excerpt {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--sub-color);
    font-style: italic;
  }

  /* サムネイル */
  .thumbnail-wrapper {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .thumbnail {
    max-width: 100%;
    height: auto;
    box-shadow: 0 8px 30px rgba(43, 35, 33, 0.12);
    border: 8px solid white;
  }

  .thumbnail-caption {
    font-size: 0.75rem;
    color: var(--sub-color);
    margin-top: 0.8rem;
    font-style: italic;
  }

  /* 本文 */
  .article-content {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.05rem;
    line-height: 2.2;
    color: var(--ink-color);
    letter-spacing: 0.02em;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
    text-indent: 1em;
  }

  .article-content :global(h2) {
    font-family: 'Zen Old Mincho', serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 3rem 0 1.5rem;
    color: var(--ink-color);
    text-align: center;
    letter-spacing: 0.1em;
  }

  .article-content :global(h2)::before {
    content: '＊';
    display: block;
    font-size: 0.8rem;
    color: var(--accent-color);
    margin-bottom: 0.5rem;
  }

  .article-content :global(strong) {
    color: var(--ink-color);
    font-weight: 700;
  }

  .article-content :global(blockquote),
  .article-content :global(div[style*="background-color"]) {
    border-left: 2px solid var(--accent-color);
    padding: 1.2rem 1.5rem;
    margin: 2rem 0;
    background: rgba(140, 58, 38, 0.03);
    font-style: italic;
  }

  .article-content :global(div[style*="text-align: center"]) {
    font-family: 'Zen Old Mincho', serif;
    letter-spacing: 0.1em;
  }

  .article-content :global(div[style*="font-size: 1.3em"]) {
    font-family: 'Zen Old Mincho', serif;
    color: var(--accent-color);
    margin: 2rem 0;
  }

  .article-content :global(hr) {
    border: none;
    text-align: center;
    margin: 2.5rem 0;
  }

  .article-content :global(hr)::after {
    content: '＊　＊　＊';
    color: var(--sub-color);
    font-size: 0.8rem;
    letter-spacing: 0.5em;
  }

  /* リーダーリンク */
  .reader-link-wrapper {
    text-align: center;
    margin: 3rem 0;
    padding: 1.5rem;
    border: 1px dashed var(--line-color);
  }

  .reader-link {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.85rem;
    color: var(--accent-color);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: opacity 0.2s;
  }

  .reader-link:hover {
    opacity: 0.7;
  }

  /* 前後ナビ */
  .episode-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2.5rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line-color);
  }

  .nav-link {
    display: block;
    padding: 1.2rem;
    text-decoration: none;
    border: 1px solid var(--line-color);
    transition: all 0.2s;
  }

  .nav-link:hover {
    border-color: var(--accent-color);
    background: rgba(140, 58, 38, 0.02);
  }

  .nav-prev { text-align: left; }
  .nav-next { text-align: right; }

  .nav-direction {
    display: block;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.65rem;
    color: var(--sub-color);
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }

  .nav-title {
    display: block;
    font-family: 'Shippori Mincho', serif;
    font-size: 0.85rem;
    color: var(--ink-color);
    line-height: 1.5;
  }

  /* フッター */
  .article-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    background: transparent;
    border: 1px solid var(--line-color);
    color: var(--sub-color);
    text-decoration: none;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: all 0.2s;
  }

  .back-button:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #f7f4eb;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sub-color);
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .article-wrapper {
      padding: 2rem 1.25rem 3rem;
    }

    .article-title {
      font-size: 1.4rem;
    }

    .article-content {
      font-size: 1rem;
      line-height: 2;
    }

    .episode-nav {
      grid-template-columns: 1fr;
    }

    .nav-next { text-align: left; }

    .article-footer {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
