  };
  // TODO: 将来追加予定
  // - あいぼーモード（ピンク系 #ff69b4）
  // - 道ゐモード（水色系 #00bfff）

  // ================================
  // グローテーマ
  // ================================
  const glowThemes = {
    cyber: { glow1: '#00ffff', glow2: '#ff00ff', glow3: '#00ff88' },
    sunset: { glow1: '#ff6b35', glow2: '#f7931e', glow3: '#ff4500' },
    aurora: { glow1: '#00ff88', glow2: '#00bfff', glow3: '#00ffaa' },
    sakura: { glow1: '#ffb7c5', glow2: '#ff69b4', glow3: '#ffc0cb' },
    galaxy: { glow1: '#9b59b6', glow2: '#3498db', glow3: '#8e44ad' },
    none: { glow1: 'transparent', glow2: 'transparent', glow3: 'transparent' }
  };

  // ================================
  // フォント定義
  // ================================
  const fontStyles = {
    noto: "'Noto Sans JP', sans-serif",
    maru: "'Zen Maru Gothic', sans-serif",
    mincho: "'Zen Old Mincho', serif",
    klee: "'Klee One', cursive",
    sawarabi: "'Sawarabi Gothic', sans-serif"
  };

  // ================================
  // 吹き出しスタイル（あいぼー/道ゐ別・暗→明に対応）
  // ================================
  const bubbleStyles = {
    // 暗い背景用（プリセット1〜3）
    glass: {
      aibou: { bg: 'rgba(255,107,157,0.1)', border: 'rgba(255,107,157,0.3)', text: '#ffffff', nameColor: '#ff6b9d' },
      michi: { bg: 'rgba(0,191,255,0.1)', border: 'rgba(0,191,255,0.3)', text: '#ffffff', nameColor: '#00bfff' }
    },
    dark: {
      aibou: { bg: 'rgba(0,0,0,0.7)', border: '#ff6b9d', text: '#ffffff', nameColor: '#ff6b9d' },
      michi: { bg: 'rgba(0,0,0,0.7)', border: '#00bfff', text: '#ffffff', nameColor: '#00bfff' }
    },
    neon: {
      aibou: { bg: 'rgba(0,0,0,0.8)', border: '#ff6b9d', text: '#ffffff', nameColor: '#ff6b9d', borderWidth: '2px', shadow: '0 0 15px rgba(255,107,157,0.3)' },
      michi: { bg: 'rgba(0,0,0,0.8)', border: '#00ffff', text: '#ffffff', nameColor: '#00ffff', borderWidth: '2px', shadow: '0 0 15px rgba(0,255,255,0.3)' }
    },
    // 明るい背景用（プリセット4〜5）
    pastel: {
      aibou: { bg: 'rgba(255,240,245,0.9)', border: '#f0c0d0', text: '#333333', nameColor: '#d44a7a' },
      michi: { bg: 'rgba(240,248,255,0.9)', border: '#c0d0f0', text: '#333333', nameColor: '#0077aa' }
    },
    solid: {
      aibou: { bg: '#ffffff', border: '#e8e8e8', text: '#333333', nameColor: '#d44a7a' },
      michi: { bg: '#ffffff', border: '#e8e8e8', text: '#333333', nameColor: '#0088cc' }
    }
  };

  // ================================
  // スタイル適用関数
  // ================================
  function applyStyles() {
    const page = document.querySelector('.post-page');
    const content = document.querySelector('.article-content');
    const videoBgContainer = document.getElementById('video-bg-container');
    if (!page) return;

    // 動画背景（裏モード）
    const articleMain = document.querySelector('.article-main');
    const cyberOverlay = document.querySelector('.cyber-overlay');
    const cyberParticles = document.querySelector('.cyber-particles');

    if (videoBgContainer) {
      if (currentState.videoBg) {
        videoBgContainer.style.display = 'block';
        // 裏モード：全ての背景を完全に透明に
        page.style.background = 'none';
        page.classList.add('ura-mode');
        if (articleMain) articleMain.style.background = 'none';
        if (content) content.style.background = 'none';
        if (cyberOverlay) cyberOverlay.style.display = 'none';
        if (cyberParticles) cyberParticles.style.display = 'none';
      } else {
        videoBgContainer.style.display = 'none';
        page.classList.remove('ura-mode');
        if (cyberOverlay) cyberOverlay.style.display = '';
        if (cyberParticles) cyberParticles.style.display = '';
      }
    }

    // 背景（動画背景でない場合のみ適用）
    if (!currentState.videoBg) {
      const bgStyle = baseBgStyles[currentState.baseBg];
      if (bgStyle) {
        page.style.background = bgStyle.bg;
        page.style.backgroundAttachment = 'fixed';
        if (content) {
          content.style.color = bgStyle.textColor;
          content.style.background = ''; // 背景をリセット
        }
        if (articleMain) articleMain.style.background = ''; // 背景をリセット
      }
    } else {
      // 動画背景時は文字色を白に
      if (content) {
        content.style.color = '#ffffff';
      }
    }

    // 背景エフェクト（網の場合はグロー+スクロール連動を自動ON）
    const effectTypes = ['grid', 'dots', 'mesh'];
    const isMeshEffect = currentState.bgEffect === 'mesh';

    effectTypes.forEach(type => {
      const layer = document.getElementById(`bg-effect-${type}`);
      if (layer) {
        if (currentState.bgEffect === type) {
          layer.classList.add('active', `bg-effect-${type}`);
        } else {
          layer.classList.remove('active');
        }
      }
    });

    // グロー（網エフェクト時のみ有効、それ以外は透明）
    if (isMeshEffect) {
      // 網の場合：グローを表示、スクロール連動を有効化
      const glow = glowThemes[currentState.glowTheme];
      if (glow) {
        page.style.setProperty('--glow-1', glow.glow1);
        page.style.setProperty('--glow-2', glow.glow2);
        page.style.setProperty('--glow-3', glow.glow3);
      }
      // スクロール連動を自動ON
      if (!currentState.glowSyncEnabled) {
        currentState.glowSyncEnabled = true;
        startGlowSync();
      }
    } else {
      // 網以外：グローを非表示
      page.style.setProperty('--glow-1', 'transparent');
      page.style.setProperty('--glow-2', 'transparent');
      page.style.setProperty('--glow-3', 'transparent');
      // スクロール連動を停止
      if (currentState.glowSyncEnabled) {
        currentState.glowSyncEnabled = false;
        stopGlowSync();
      }
    }

    // フォント
    const font = fontStyles[currentState.font];
    if (font) {
      // article-contentに適用
      if (content) {
        content.style.fontFamily = font;
      }
      // AI Journey用：吹き出しにもフォントを適用
      document.querySelectorAll('.aibou-bubble, .michi-bubble').forEach(el => {
        el.style.fontFamily = font;
      });
    }

    // ズーム（transform: scaleで枠も含めて全体を拡大縮小）
    // 表示100% = scale(1.0)、50%〜150% = scale(0.5)〜scale(1.5)
    const articleContainer = document.getElementById('article-container');
    if (articleContainer) {
      const scale = currentState.zoom / 100;
      articleContainer.style.transform = `scale(${scale})`;
      articleContainer.style.transformOrigin = 'top center';
    }

    // ズーム表示を直接更新（確実に反映させるため）
    const zoomLevelDisplay = document.getElementById('zoom-level');
    if (zoomLevelDisplay) {
      zoomLevelDisplay.textContent = `${currentState.zoom}%`;
    }

    // 吹き出しスタイル（AI Journey記事用：あいぼー/道ゐ別）
    const bubbleStyle = bubbleStyles[currentState.bubbleStyle];
    if (bubbleStyle) {
      // あいぼーの吹き出し
      document.querySelectorAll('.aibou-bubble').forEach(el => {
        const style = bubbleStyle.aibou;
        el.style.background = style.bg;
        el.style.borderColor = style.border;
        el.style.borderWidth = style.borderWidth || '1px';
        el.style.color = style.text;
        el.style.boxShadow = style.shadow || 'none';
      });
      document.querySelectorAll('.aibou-name').forEach(el => {
        el.style.color = bubbleStyle.aibou.nameColor;
      });
      // 道ゐの吹き出し
      document.querySelectorAll('.michi-bubble').forEach(el => {
        const style = bubbleStyle.michi;
        el.style.background = style.bg;
        el.style.borderColor = style.border;
        el.style.borderWidth = style.borderWidth || '1px';
        el.style.color = style.text;
        el.style.boxShadow = style.shadow || 'none';
      });
      document.querySelectorAll('.michi-name').forEach(el => {
        el.style.color = bubbleStyle.michi.nameColor;
      });
    }

    // ネオンテキストのスタイル切り替え（重要な部分のみ目立たせる）
    // 暗い背景（1-3）: ネオン効果ON、明るい背景（4-5）: 太字のみ
    const isDarkMode = ['black', 'navy', 'gray'].includes(currentState.baseBg);

    // シアン系の重要テキスト
    document.querySelectorAll('.neon-cyan').forEach(el => {
      if (isDarkMode) {
        el.style.color = '#00ffff';
        el.style.textShadow = '0 0 8px #00ffff';
        el.style.fontWeight = '500';
      } else {
        el.style.color = '#007799';
        el.style.textShadow = 'none';
        el.style.fontWeight = 'bold';
      }
    });

    // ピンク系の重要テキスト
    document.querySelectorAll('.neon-pink').forEach(el => {
      if (isDarkMode) {
        el.style.color = '#ff6b9d';
        el.style.textShadow = '0 0 8px #ff6b9d';
        el.style.fontWeight = '500';
      } else {
        el.style.color = '#d44a7a';
        el.style.textShadow = 'none';
        el.style.fontWeight = 'bold';
      }
    });

    // イエロー系の重要テキスト
    document.querySelectorAll('.neon-yellow').forEach(el => {
      if (isDarkMode) {
        el.style.color = '#ffff00';
        el.style.textShadow = '0 0 8px #ffff00';
        el.style.fontWeight = '500';
      } else {
        el.style.color = '#cc8800';
        el.style.textShadow = 'none';
        el.style.fontWeight = 'bold';
      }
    });

    // マーカー（蛍光ペン風）の調整
    document.querySelectorAll('.marker-yellow, .marker-pink, .marker-blue, .marker-green').forEach(el => {
      if (isDarkMode) {
        el.style.opacity = '0.9';
      } else {
        el.style.opacity = '1';
      }
    });

    // ボタンのアクティブ状態を更新
    updateButtonStates();
  }

  function updateButtonStates() {
    // プリセットボタン
    document.querySelectorAll('.preset-btn').forEach(btn => {
      const preset = btn.dataset.preset;
      btn.classList.toggle('active', parseInt(preset) === currentState.activePreset);
    });

    // フォントボタン
    document.querySelectorAll('.font-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.font === currentState.font);
    });

    // 背景ボタン
    document.querySelectorAll('.bg-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.bg === currentState.baseBg);
    });

    // グローボタン
    document.querySelectorAll('.glow-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.glow === currentState.glowTheme);
    });

    // 吹き出しボタン
    document.querySelectorAll('.bubble-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.bubble === currentState.bubbleStyle);
    });

    // エフェクトボタン
    document.querySelectorAll('.effect-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.effect === currentState.bgEffect);
    });

    // ズーム表示
    const zoomLevel = document.getElementById('zoom-level');
    if (zoomLevel) {
      zoomLevel.textContent = `${currentState.zoom}%`;
    }

    // マイプリセット
    document.querySelectorAll('.mypreset-btn').forEach(btn => {
      const slot = btn.dataset.slot;
      btn.classList.toggle('saved', myPresets[slot] !== null);
    });

    // 裏モードボタン
    const uraModeBtn = document.getElementById('ura-mode-btn');
    if (uraModeBtn) {
      uraModeBtn.classList.toggle('active', currentState.videoBg);
      uraModeBtn.textContent = currentState.videoBg ? '動画背景 ON' : '動画背景 OFF';
    }
  }

  // ================================
  // 保存・復元
  // ================================
  function saveState() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(currentState));
    localStorage.setItem(STORAGE_KEY + '-my', JSON.stringify(myPresets));
  }

  function loadState() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        currentState = { ...currentState, ...JSON.parse(saved) };
      } catch (e) {}
    }
    const savedMy = localStorage.getItem(STORAGE_KEY + '-my');
    if (savedMy) {
      try {
        myPresets = JSON.parse(savedMy);
      } catch (e) {}
    }
  }

  // ================================
  // イベントリスナー設定
  // ================================
  function setupEventListeners() {
    // CUSTOMIZEボタン（開閉トグル）
    const customizeBtn = document.getElementById('customize-btn');
    const customizeCard = document.querySelector('.customize-card');
    const customizeLabel = customizeBtn?.querySelector('.customize-label');
    const switcher = document.getElementById('global-style-switcher');
    const closeBtn = document.getElementById('switcher-close');

    function openSwitcher() {
      if (switcher) switcher.style.display = 'block';
      if (customizeBtn) customizeBtn.classList.add('active');
      if (customizeCard) customizeCard.classList.add('active');
      if (customizeLabel) customizeLabel.textContent = 'CLOSE';
    }

    function closeSwitcher() {
      if (switcher) switcher.style.display = 'none';
      if (customizeBtn) customizeBtn.classList.remove('active');
      if (customizeCard) customizeCard.classList.remove('active');
      if (customizeLabel) customizeLabel.textContent = 'OPEN';
    }

    if (customizeBtn && switcher) {
      customizeBtn.addEventListener('click', () => {
        const isOpen = switcher.style.display === 'block';
        if (isOpen) {
          closeSwitcher();
        } else {
          openSwitcher();
        }
      });
    }

    if (closeBtn && switcher) {
      closeBtn.addEventListener('click', () => {
        closeSwitcher();
      });
    }

    // プリセットボタン
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const num = parseInt(btn.dataset.preset);
        const preset = recommendedPresets[num];
        if (preset) {
          // 裏モードをOFFにする
          currentState.videoBg = false;
          currentState = { ...currentState, ...preset, activePreset: num };
          applyStyles();
          saveState();
        }
      });
    });

    // 裏モードボタン
    const uraModeBtn = document.getElementById('ura-mode-btn');
    if (uraModeBtn) {
      uraModeBtn.addEventListener('click', () => {
        currentState.videoBg = !currentState.videoBg;
        applyStyles();
        saveState();
      });
    }

    // フォントボタン
    document.querySelectorAll('.font-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentState.font = btn.dataset.font;
        applyStyles();
        saveState();
      });
    });

    // 背景ボタン
    document.querySelectorAll('.bg-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentState.baseBg = btn.dataset.bg;
        applyStyles();
        saveState();
      });
    });

    // グローボタン
    document.querySelectorAll('.glow-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentState.glowTheme = btn.dataset.glow;
        applyStyles();
        saveState();
      });
    });

    // 吹き出しボタン
    document.querySelectorAll('.bubble-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentState.bubbleStyle = btn.dataset.bubble;
        applyStyles();
        saveState();
      });
    });

    // エフェクトボタン
    document.querySelectorAll('.effect-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentState.bgEffect = btn.dataset.effect;
        applyStyles();
        saveState();
        // ボタンのactive状態を更新
        document.querySelectorAll('.effect-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.effect === currentState.bgEffect);
        });
      });
    });

    // ズームボタン
    const zoomMinus = document.getElementById('zoom-minus');
    const zoomPlus = document.getElementById('zoom-plus');
    const zoomReset = document.getElementById('zoom-reset');

    if (zoomMinus) {
      zoomMinus.addEventListener('click', () => {
        currentState.zoom = Math.max(50, currentState.zoom - 10);  // 最小50% = scale(0.5)
        applyStyles();
        saveState();
      });
    }

    if (zoomPlus) {
      zoomPlus.addEventListener('click', () => {
        currentState.zoom = Math.min(150, currentState.zoom + 10);  // 最大150% = scale(1.5)
        applyStyles();
        saveState();
      });
    }

    if (zoomReset) {
      zoomReset.addEventListener('click', () => {
        currentState.zoom = 100;
        applyStyles();
        saveState();
      });
    }

    // マイプリセットボタン
    document.querySelectorAll('.mypreset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slot = btn.dataset.slot;
        if (myPresets[slot]) {
          currentState = { ...currentState, ...myPresets[slot] };
          applyStyles();
          saveState();
        } else {
          alert(`マイプリセット ${slot} は未設定です。\n「保存」ボタンで現在の設定を保存できます。`);
        }
      });
    });

    // マイプリセット保存
    const mypresetSave = document.getElementById('mypreset-save');
    if (mypresetSave) {
      mypresetSave.addEventListener('click', () => {
        const slot = prompt('保存先を選んでください (1, 2, 3):');
        if (slot && ['1', '2', '3'].includes(slot)) {
          myPresets[slot] = { ...currentState };
          saveState();
          updateButtonStates();
          alert(`マイプリセット ${slot} に保存しました！`);
        }
      });
    }

    // リセットボタン
    const resetAll = document.getElementById('reset-all');
    if (resetAll) {
      resetAll.addEventListener('click', () => {
        if (confirm('設定をリセットしますか？\n（プリセット1に戻ります）')) {
          localStorage.removeItem(STORAGE_KEY);
          localStorage.removeItem(STORAGE_KEY + '-my');
          location.reload();
        }
      });
    }

    // グロウ連動チェックボックス
    const glowSyncCheckbox = document.getElementById('glow-sync-checkbox');
    if (glowSyncCheckbox) {
      // 初期状態を設定
      glowSyncCheckbox.checked = currentState.glowSyncEnabled;

      glowSyncCheckbox.addEventListener('change', (e) => {
        currentState.glowSyncEnabled = e.target.checked;
        saveState();

        if (currentState.glowSyncEnabled) {
          startGlowSync();
        } else {
          stopGlowSync();
        }
      });
    }

    // ================================
    // モバイル用ボタンのイベントリスナー
    // ================================

    // モバイルCUSTOMIZEボタン
    const customizeBtnMobile = document.getElementById('customize-btn-mobile');
    if (customizeBtnMobile && switcher) {
      customizeBtnMobile.addEventListener('click', () => {
        const isOpen = switcher.style.display === 'block';
        if (isOpen) {
          closeSwitcher();
          customizeBtnMobile.classList.remove('active');
        } else {
          openSwitcher();
          customizeBtnMobile.classList.add('active');
          // 他のドロップダウンを閉じる
          const learningsDropdown = document.getElementById('mobile-learnings-dropdown');
          const transmitDropdown = document.getElementById('mobile-transmit-dropdown');
          if (learningsDropdown) learningsDropdown.style.display = 'none';
          if (transmitDropdown) transmitDropdown.style.display = 'none';
          document.getElementById('learnings-btn-mobile')?.classList.remove('active');
          document.getElementById('transmit-btn-mobile')?.classList.remove('active');
        }
      });
    }

    // モバイルLEARNINGSボタン
    const learningsBtnMobile = document.getElementById('learnings-btn-mobile');
    const learningsDropdown = document.getElementById('mobile-learnings-dropdown');
    if (learningsBtnMobile && learningsDropdown) {
      learningsBtnMobile.addEventListener('click', () => {
        const isOpen = learningsDropdown.style.display === 'block';
        if (isOpen) {
          learningsDropdown.style.display = 'none';
          learningsBtnMobile.classList.remove('active');
        } else {
          learningsDropdown.style.display = 'block';
          learningsBtnMobile.classList.add('active');
          // 他のドロップダウンを閉じる
          const transmitDropdown = document.getElementById('mobile-transmit-dropdown');
          if (transmitDropdown) transmitDropdown.style.display = 'none';
          if (switcher) switcher.style.display = 'none';
          document.getElementById('transmit-btn-mobile')?.classList.remove('active');
          customizeBtnMobile?.classList.remove('active');
          if (customizeBtn) customizeBtn.classList.remove('active');
          if (customizeCard) customizeCard.classList.remove('active');
          if (customizeLabel) customizeLabel.textContent = 'OPEN';
        }
      });

      // リンククリックでドロップダウンを閉じる
      learningsDropdown.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          learningsDropdown.style.display = 'none';
          learningsBtnMobile.classList.remove('active');
        });
      });
    }

    // モバイルTRANSMITボタン
    const transmitBtnMobile = document.getElementById('transmit-btn-mobile');
    const transmitDropdown = document.getElementById('mobile-transmit-dropdown');
    if (transmitBtnMobile && transmitDropdown) {
      transmitBtnMobile.addEventListener('click', () => {
        const isOpen = transmitDropdown.style.display === 'block';
        if (isOpen) {
          transmitDropdown.style.display = 'none';
          transmitBtnMobile.classList.remove('active');
        } else {
          transmitDropdown.style.display = 'block';
          transmitBtnMobile.classList.add('active');
          // 他のドロップダウンを閉じる
          if (learningsDropdown) learningsDropdown.style.display = 'none';
          if (switcher) switcher.style.display = 'none';
          learningsBtnMobile?.classList.remove('active');
          customizeBtnMobile?.classList.remove('active');
          if (customizeBtn) customizeBtn.classList.remove('active');
          if (customizeCard) customizeCard.classList.remove('active');
          if (customizeLabel) customizeLabel.textContent = 'OPEN';
        }
      });
    }

    // モバイルシェアボタン（X）
    const shareXMobile = document.getElementById('share-x-mobile');
    if (shareXMobile) {
      shareXMobile.addEventListener('click', (e) => {
        e.preventDefault();
        const url = encodeURIComponent(window.location.href);
        const text = encodeURIComponent(document.title);
        window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank');
      });
    }

    // モバイルシェアボタン（Facebook）
    const shareFbMobile = document.getElementById('share-fb-mobile');
    if (shareFbMobile) {
      shareFbMobile.addEventListener('click', (e) => {
        e.preventDefault();
        const url = encodeURIComponent(window.location.href);
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank');
      });
    }

    // モバイルコピーリンクボタン
    const copyLinkMobile = document.getElementById('copy-link-mobile');
    if (copyLinkMobile) {
      copyLinkMobile.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyLinkMobile.querySelector('span:last-child').textContent;
          copyLinkMobile.querySelector('span:last-child').textContent = 'COPIED!';
          copyLinkMobile.style.color = '#00ff88';
          setTimeout(() => {
            copyLinkMobile.querySelector('span:last-child').textContent = originalText;
            copyLinkMobile.style.color = '';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    }
  }

  // ================================
  // スクロール連動機能
  // ================================
  let glowSyncRAF = null;

  function startGlowSync() {
    if (glowSyncRAF) return;

    const page = document.querySelector('.post-page');
    if (!page) return;

    function updateGlowOnScroll() {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollProgress = Math.min(scrollY / Math.max(docHeight, 1), 1);

      // スクロール位置に応じてテーマをブレンド（ゆっくり変化：5倍遅く）
      const themeCount = scrollGlowThemes.length;
      // 0.2倍速にすることで、ページ全体スクロールで約1テーマ分だけ変化
      const exactIndex = (scrollProgress * (themeCount - 1)) * 0.2;
      const lowerIndex = Math.floor(exactIndex);
      const upperIndex = Math.min(lowerIndex + 1, themeCount - 1);
      const blend = exactIndex - lowerIndex;

      const lowerTheme = glowThemes[scrollGlowThemes[lowerIndex]];
      const upperTheme = glowThemes[scrollGlowThemes[upperIndex]];

      if (lowerTheme && upperTheme) {
        // 2つのテーマ間で色を補間
        function blendColor(c1, c2, t) {
          const r1 = parseInt(c1.slice(1, 3), 16);
          const g1 = parseInt(c1.slice(3, 5), 16);
          const b1 = parseInt(c1.slice(5, 7), 16);
          const r2 = parseInt(c2.slice(1, 3), 16);
          const g2 = parseInt(c2.slice(3, 5), 16);
          const b2 = parseInt(c2.slice(5, 7), 16);
          const r = Math.round(r1 + (r2 - r1) * t);
          const g = Math.round(g1 + (g2 - g1) * t);
          const b = Math.round(b1 + (b2 - b1) * t);
          return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
        }

        page.style.setProperty('--glow-1', blendColor(lowerTheme.glow1, upperTheme.glow1, blend));
        page.style.setProperty('--glow-2', blendColor(lowerTheme.glow2, upperTheme.glow2, blend));
        page.style.setProperty('--glow-3', blendColor(lowerTheme.glow3, upperTheme.glow3, blend));
      }

      if (currentState.glowSyncEnabled) {
        glowSyncRAF = requestAnimationFrame(updateGlowOnScroll);
      }
    }

    glowSyncRAF = requestAnimationFrame(updateGlowOnScroll);
  }

  function stopGlowSync() {
    if (glowSyncRAF) {
      cancelAnimationFrame(glowSyncRAF);
      glowSyncRAF = null;
    }
    // 現在選択されているグローテーマに戻す
    applyStyles();
  }

  // ================================
  // デフォルトプリセット取得（frontmatterのdefaultPreset優先）
  // ================================
  function getDefaultPreset() {
    // frontmatterで指定されたdefaultPresetを優先
    const page = document.querySelector('[data-default-preset]');
    if (page && page.dataset.defaultPreset) {
      const preset = parseInt(page.dataset.defaultPreset, 10);
      if (preset >= 1 && preset <= 5) {
        return preset;
      }
    }
    // フォールバック：カテゴリ別デフォルト
    const category = document.querySelector('[data-category]')?.dataset.category;
    if (category === 'ai-journey') {
      return 1;
    }
    if (category === 'ai-tips') {
      return 5;
    }
    return 4;
  }

  // ================================
  // 初期化
  // ================================
  document.addEventListener('DOMContentLoaded', () => {
    loadState();

    // 初回訪問者はカテゴリ別デフォルトプリセットを適用
    if (!localStorage.getItem(STORAGE_KEY)) {
      const defaultPreset = getDefaultPreset();
      const preset = recommendedPresets[defaultPreset];
      if (preset) {
        currentState = { ...currentState, ...preset, activePreset: defaultPreset };
      }

      // frontmatterで指定されたdefaultBgEffectを適用
      const page = document.querySelector('[data-default-bg-effect]');
      if (page && page.dataset.defaultBgEffect) {
        const effect = page.dataset.defaultBgEffect;
        if (['none', 'grid', 'dots', 'mesh'].includes(effect)) {
          currentState.bgEffect = effect;
        }
      }
    }

    applyStyles();
    setupEventListeners();

    // モバイル表示時（1300px未満）はスタイルパネルをbodyに移動
    // （親要素のtransformがあるとposition:fixedが機能しないため）
    function handlePanelPosition() {
      const switcher = document.getElementById('global-style-switcher');
      if (!switcher) return;

      const isMobile = window.innerWidth < 1300;
      const isInBody = switcher.parentElement === document.body;

      if (isMobile && !isInBody) {
        // モバイル：bodyに移動
        document.body.appendChild(switcher);
      } else if (!isMobile && isInBody) {
        // デスクトップ：元の場所に戻す
        const stylePanelSpace = document.querySelector('.style-panel-space');
        if (stylePanelSpace) {
          stylePanelSpace.appendChild(switcher);
        }
      }
    }

    handlePanelPosition();
    window.addEventListener('resize', handlePanelPosition);

    // グロウ連動が有効だった場合は開始
    if (currentState.glowSyncEnabled) {
      startGlowSync();
    }
  });
})();
</script>

