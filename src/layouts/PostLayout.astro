<!-- ===== PANDORA風タブ切り替え JavaScript ===== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.posts-tab');
    const tabContents = document.querySelectorAll('.posts-tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetTab = tab.dataset.tab;

        // 全タブから active を削除
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));

        // クリックしたタブに active を追加
        tab.classList.add('active');
        const targetContent = document.getElementById(`tab-${targetTab}`);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });
  });
</script>

<!-- ===== PANDORA風スクロール時LEARNINGS固定 JavaScript ===== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const learningsCard = document.querySelector('.learnings-card');
    const sidebar = document.querySelector('.article-sidebar');
    const postsTabsCard = document.querySelector('.posts-tabs-card');

    if (!learningsCard || !sidebar) return;

    // 1300px以上の時のみ動作
    const checkWidth = () => window.innerWidth >= 1300;

    // スクロール位置でLEARNINGSカードのsticky状態を切り替え
    let isSticky = false;
    let stickyThreshold = 0;

    const updateStickyThreshold = () => {
      if (!checkWidth()) return;
      // タブカードの下端を基準にする
      if (postsTabsCard) {
        const rect = postsTabsCard.getBoundingClientRect();
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        stickyThreshold = rect.bottom + scrollTop - 60; // 60px = ヘッダー分
      } else {
        // タブカードがない場合はサイドバーの上端
        const sidebarRect = sidebar.getBoundingClientRect();
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        stickyThreshold = sidebarRect.top + scrollTop + 200;
      }
    };

    const handleScroll = () => {
      if (!checkWidth()) {
        learningsCard.classList.remove('is-sticky');
        return;
      }

      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > stickyThreshold && !isSticky) {
        isSticky = true;
        learningsCard.classList.add('is-sticky');
      } else if (scrollTop <= stickyThreshold && isSticky) {
        isSticky = false;
        learningsCard.classList.remove('is-sticky');
      }
    };

    // 初期化
    updateStickyThreshold();
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', () => {
      updateStickyThreshold();
      handleScroll();
    });
  });
</script>

