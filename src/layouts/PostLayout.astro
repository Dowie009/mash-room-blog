---
/**
 * PostLayout.astro - 記事ページ専用レイアウト
 *
 * エレガント/和モダンテーマ - AI関連記事に最適化
 *
 * 以前のサイバー/ダークテーマは _archive/postlayout-legacy/ に保存
 */
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    category: string;
    description?: string;
    tags?: string[];
    thumbnail?: string;
    learningLevel?: number;
    topic?: string;
    learnings?: string[];
    defaultPreset?: number;
    heroImage?: string;
    readTime?: string;
  };
  collection?: 'tech' | 'gear' | 'story' | 'ai';
}

const { frontmatter, collection = 'tech' } = Astro.props;

// 日付フォーマット
const formatDate = (date: Date) => {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// カテゴリ表示名とカラー
const categoryConfig: Record<string, { label: string; color: string }> = {
  'ai-journey': { label: 'AI JOURNEY', color: '#8b7355' },
  'ai-tips': { label: 'AI TIPS', color: '#8b7355' },
  daw: { label: 'DAW', color: '#8b7355' },
  gear: { label: 'GEAR', color: '#8b7355' },
  plugin: { label: 'PLUGIN', color: '#8b7355' },
  biz: { label: 'BIZ', color: '#8b7355' },
  tips: { label: 'TIPS', color: '#8b7355' },
  essay: { label: 'ESSAY', color: '#8b7355' },
  story: { label: 'STORY', color: '#8b7355' },
  diary: { label: 'DIARY', color: '#8b7355' },
  review: { label: 'REVIEW', color: '#8b7355' },
};

// コレクションごとの設定
const collectionConfig: Record<string, { href: string; label: string }> = {
  tech: { href: '/tech', label: 'TECH LAB' },
  gear: { href: '/gear', label: 'GEAR LAB' },
  story: { href: '/story', label: 'STORY LAB' },
};

const config = collectionConfig[collection] || collectionConfig.tech;
const catConfig = categoryConfig[frontmatter.category] || { label: frontmatter.category.toUpperCase(), color: '#8b7355' };

// 読了時間
const readTime = frontmatter.readTime || '5 min read';

// 関連記事用：最新記事リスト
let relatedPosts: Array<{ slug: string; title: string; date: Date; thumbnail?: string; category: string }> = [];

if (collection === 'tech') {
  const allPosts = await getCollection('tech', ({ data }) => !data.draft);
  const currentSlug = Astro.url.pathname.split('/').pop();
  const filteredPosts = allPosts.filter(post => post.slug !== currentSlug);

  relatedPosts = filteredPosts
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3)
    .map(post => ({
      slug: post.slug,
      title: post.data.title,
      date: post.data.date,
      thumbnail: post.data.thumbnail,
      category: post.data.category
    }));
}

// ヒーロー画像
const heroImage = frontmatter.heroImage || frontmatter.thumbnail || 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=1920';
---

<Layout title={`${frontmatter.title} | ${config.label}`}>
  <div class="elegant-post">
    <!-- Progress Bar -->
    <div class="progress-bar" id="progressBar"></div>

    <!-- Chapter Nav -->
    <nav class="chapter-nav" id="chapterNav">
      <!-- JS で動的に生成 -->
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg">
        <img src={heroImage} alt={frontmatter.title} />
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <div class="hero-label">{catConfig.label}</div>
        <h1 class="hero-title serif">{frontmatter.title}</h1>
        <div class="hero-meta">
          <span>道ゐ / Dowie</span>
          <span>{formatDate(frontmatter.date)}</span>
          <span>{readTime}</span>
        </div>
      </div>
      <div class="hero-scroll">
        <span>Scroll</span>
      </div>
    </section>

    <!-- Article Content -->
    <article class="article-content">
      <div class="article-container prose">
        <slot />
      </div>
    </article>

    <!-- Author -->
    <section class="article-container">
      <div class="author-section">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200" alt="Author" class="author-avatar" />
        <div class="author-info">
          <h4 class="serif">道ゐ / Dowie</h4>
          <div class="author-role">Music Producer</div>
          <p class="author-bio">
            音楽スタジオ運営 / A-Sketch新人発掘担当。AIツールを活用した効率的なコンテンツ制作を日々研究しています。北海道でスタジオを改装し、音楽制作の新しい形を模索中。
          </p>
        </div>
      </div>

      <!-- Share -->
      <div class="share-section">
        <button class="share-btn" id="shareTwitter">𝕏</button>
        <button class="share-btn" id="shareFacebook">f</button>
        <button class="share-btn" id="copyLink">🔗</button>
      </div>
    </section>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="related-header">
          <h3 class="serif">Related Articles</h3>
        </div>
        <div class="related-grid">
          {relatedPosts.map(post => (
            <a href={`/tech/${post.slug}`} class="related-item">
              <div class="related-image">
                <img src={post.thumbnail || 'https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=600'} alt={post.title} />
              </div>
              <div class="related-category">{categoryConfig[post.category]?.label || post.category}</div>
              <h4 class="related-title serif">{post.title}</h4>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer -->
    <footer>
      <div class="footer-inner">
        <div class="footer-brand serif">MASHROOM STUDIO</div>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/tech">Tech</a>
          <a href="/gear">Gear</a>
          <a href="/story">Story</a>
        </div>
      </div>
      <div class="footer-copyright">
        © 2026 道ゐ / Dowie. All rights reserved.
      </div>
    </footer>

    <!-- Back to Top -->
    <button class="back-to-top" id="backToTop">↑</button>
  </div>
</Layout>

<style is:global>
  /* エレガントテーマ用グローバルスタイル */
  .elegant-post {
    --bg: #faf9f7;
    --bg-alt: #f3f1ed;
    --bg-dark: #1a1a1a;
    --text: #2a2a2a;
    --text-light: #5a5a5a;
    --text-muted: #8a8a8a;
    --accent: #8b7355;
    --accent-light: #a89070;
    --border: #e5e2dc;
    --white: #ffffff;
  }

  .elegant-post {
    background: var(--bg);
    color: var(--text);
    font-family: 'Noto Sans JP', sans-serif;
    line-height: 2;
    -webkit-font-smoothing: antialiased;
  }

  .elegant-post ::selection {
    background: var(--accent);
    color: var(--white);
  }

  .elegant-post .serif {
    font-family: 'Zen Old Mincho', 'Shippori Mincho', serif;
  }

  /* Progress */
  .elegant-post .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: var(--accent);
    width: 0%;
    z-index: 9999;
  }

  /* Chapter Nav */
  .elegant-post .chapter-nav {
    position: fixed;
    left: 2.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
  }

  .elegant-post .chapter-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    margin-bottom: 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .elegant-post .chapter-dot::before {
    content: attr(data-label);
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.65rem;
    color: var(--text-muted);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
    letter-spacing: 0.05em;
  }

  .elegant-post .chapter-dot:hover::before { opacity: 1; }
  .elegant-post .chapter-dot.active { background: var(--accent); transform: scale(1.5); }

  /* Hero */
  .elegant-post .hero {
    height: 100vh;
    display: flex;
    align-items: flex-end;
    position: relative;
  }

  .elegant-post .hero-bg {
    position: absolute;
    inset: 0;
  }

  .elegant-post .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }

  .elegant-post .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0.2) 100%);
  }

  .elegant-post .hero-content {
    position: relative;
    z-index: 1;
    padding: 5rem;
    max-width: 800px;
    color: var(--white);
  }

  .elegant-post .hero-label {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .elegant-post .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .elegant-post .hero-meta {
    font-size: 0.8rem;
    opacity: 0.7;
    display: flex;
    gap: 2rem;
  }

  .elegant-post .hero-scroll {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--white);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .elegant-post .hero-scroll::after {
    content: '';
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--white), transparent);
    animation: scrollLine 2s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0%, 100% { opacity: 0.3; transform: scaleY(0.5); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* Article Container */
  .elegant-post .article-container {
    max-width: 750px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .elegant-post .article-content {
    padding: 5rem 0;
  }

  /* Prose */
  .elegant-post .prose {
    padding: 3rem 0;
  }

  .elegant-post .prose h2 {
    font-family: 'Zen Old Mincho', serif;
    font-size: 1.6rem;
    font-weight: 500;
    margin: 5rem 0 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--text);
  }

  .elegant-post .prose h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .elegant-post .prose h3 {
    font-family: 'Zen Old Mincho', serif;
    font-size: 1.2rem;
    font-weight: 500;
    margin: 3rem 0 1.5rem;
    color: var(--text);
  }

  .elegant-post .prose p {
    margin-bottom: 1.8rem;
    color: var(--text-light);
    font-size: 0.95rem;
  }

  .elegant-post .prose strong {
    color: var(--text);
    font-weight: 500;
  }

  .elegant-post .prose ul,
  .elegant-post .prose ol {
    margin: 2rem 0;
    padding-left: 1.5rem;
    color: var(--text-light);
  }

  .elegant-post .prose li {
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
  }

  .elegant-post .prose a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .elegant-post .prose a:hover {
    border-bottom-color: var(--accent);
  }

  /* Blockquote */
  .elegant-post .prose blockquote {
    margin: 3rem 0;
    padding: 2rem 2.5rem;
    background: var(--bg-alt);
    border-left: 3px solid var(--accent);
    font-family: 'Zen Old Mincho', serif;
    font-size: 1.1rem;
    color: var(--text);
    line-height: 2;
  }

  /* Code */
  .elegant-post .prose pre {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--bg-dark);
    border-radius: 4px;
    overflow-x: auto;
  }

  .elegant-post .prose code {
    font-family: 'Menlo', 'Monaco', monospace;
    font-size: 0.85rem;
    color: #e0e0e0;
  }

  .elegant-post .prose p code {
    background: var(--bg-alt);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    color: var(--text);
  }

  /* Table */
  .elegant-post .prose table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .elegant-post .prose th,
  .elegant-post .prose td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .elegant-post .prose th {
    background: var(--bg-alt);
    font-weight: 500;
    color: var(--text);
  }

  /* Author */
  .elegant-post .author-section {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .elegant-post .author-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(30%);
  }

  .elegant-post .author-info h4 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }

  .elegant-post .author-role {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .elegant-post .author-bio {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.8;
  }

  /* Share */
  .elegant-post .share-section {
    padding: 3rem 0;
    display: flex;
    justify-content: center;
    gap: 1rem;
    border-top: 1px solid var(--border);
  }

  .elegant-post .share-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .elegant-post .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Related */
  .elegant-post .related-section {
    padding: 5rem 0;
    background: var(--bg-alt);
    margin: 5rem calc(-50vw + 50%);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }

  .elegant-post .related-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .elegant-post .related-header h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }

  .elegant-post .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .elegant-post .related-item {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .elegant-post .related-image {
    aspect-ratio: 4/3;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .elegant-post .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
    transition: all 0.5s ease;
  }

  .elegant-post .related-item:hover .related-image img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .elegant-post .related-category {
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .elegant-post .related-title {
    font-size: 1rem;
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  .elegant-post .related-item:hover .related-title {
    color: var(--accent);
  }

  /* Footer */
  .elegant-post footer {
    padding: 4rem 2rem 2rem;
    background: var(--bg-dark);
    color: var(--white);
  }

  .elegant-post .footer-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .elegant-post .footer-brand {
    font-size: 1.2rem;
  }

  .elegant-post .footer-links {
    display: flex;
    gap: 2rem;
  }

  .elegant-post .footer-links a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.3s ease;
  }

  .elegant-post .footer-links a:hover {
    color: var(--white);
  }

  .elegant-post .footer-copyright {
    max-width: 1000px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }

  /* Back to Top */
  .elegant-post .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 44px;
    height: 44px;
    background: var(--white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 99;
  }

  .elegant-post .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .elegant-post .back-to-top:hover {
    background: var(--text);
    color: var(--white);
    border-color: var(--text);
  }

  /* Reveal Animation */
  .elegant-post .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease;
  }

  .elegant-post .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .elegant-post .chapter-nav { display: none; }
    .elegant-post .related-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .elegant-post { font-size: 15px; }
    .elegant-post .hero-content { padding: 3rem 2rem; }
    .elegant-post .hero-meta { flex-direction: column; gap: 0.5rem; }
    .elegant-post .author-section { grid-template-columns: 1fr; text-align: center; }
    .elegant-post .author-avatar { margin: 0 auto; }
    .elegant-post .footer-inner { flex-direction: column; gap: 2rem; text-align: center; }
  }

  /* ============================================
   * Pandora Style Components (MDから使用可能)
   * ============================================ */

  /* Point Box */
  .elegant-post .pandora-point-box {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .elegant-post .pandora-point-box h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .elegant-post .pandora-point-box ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  /* Tip Box */
  .elegant-post .pandora-tip-box {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    background: var(--bg-alt);
    border-left: 3px solid var(--accent);
  }

  .elegant-post .pandora-tip-box strong {
    color: var(--accent);
  }

  /* Warning Box */
  .elegant-post .pandora-warning-box {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    background: #fef3f2;
    border-left: 3px solid #dc2626;
  }

  /* Example Box */
  .elegant-post .pandora-example-box {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    background: var(--bg-alt);
    border-radius: 4px;
  }

  /* Conclusion Box */
  .elegant-post .pandora-conclusion-box {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--white);
    border: 2px solid var(--accent);
    border-radius: 4px;
  }

  /* Summary Box */
  .elegant-post .pandora-summary-box {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--bg-dark);
    color: var(--white);
    border-radius: 4px;
  }

  .elegant-post .pandora-summary-box h3 {
    color: var(--accent-light);
    margin-bottom: 1.5rem;
  }

  .elegant-post .pandora-summary-box ol {
    color: rgba(255,255,255,0.8);
  }

  /* Step Flow */
  .elegant-post .pandora-step-flow {
    margin: 3rem 0;
  }

  .elegant-post .pandora-step {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .elegant-post .pandora-step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    flex-shrink: 0;
  }

  .elegant-post .pandora-step-content h3 {
    margin-top: 0.5rem;
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
  }

  /* TOC */
  .elegant-post .pandora-toc {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--bg-alt);
    border-radius: 4px;
  }

  .elegant-post .pandora-toc h2 {
    font-size: 1rem;
    margin: 0 0 1rem 0;
    padding: 0;
    border: none;
  }

  .elegant-post .pandora-toc ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  .elegant-post .pandora-toc a {
    color: var(--text-light);
  }

  /* Author Box (inline) */
  .elegant-post .pandora-author-box {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--bg-alt);
    border-radius: 4px;
  }

  .elegant-post .pandora-author-box h3 {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
</style>

<script>
  // Progress Bar
  window.addEventListener('scroll', () => {
    const scroll = window.scrollY;
    const height = document.documentElement.scrollHeight - window.innerHeight;
    const progressBar = document.getElementById('progressBar');
    const backToTop = document.getElementById('backToTop');

    if (progressBar) {
      progressBar.style.width = (scroll / height * 100) + '%';
    }
    if (backToTop) {
      backToTop.classList.toggle('visible', scroll > 500);
    }
  });

  // Back to Top
  document.getElementById('backToTop')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Reveal Animation
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  reveals.forEach(el => observer.observe(el));

  // Share Functions
  document.getElementById('shareTwitter')?.addEventListener('click', () => {
    window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(location.href) + '&text=' + encodeURIComponent(document.title), '_blank');
  });

  document.getElementById('shareFacebook')?.addEventListener('click', () => {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(location.href), '_blank');
  });

  document.getElementById('copyLink')?.addEventListener('click', () => {
    navigator.clipboard.writeText(location.href);
    alert('リンクをコピーしました');
  });

  // Chapter Navigation (h2要素を自動検出)
  document.addEventListener('DOMContentLoaded', () => {
    const chapterNav = document.getElementById('chapterNav');
    const h2Elements = document.querySelectorAll('.prose h2');

    if (chapterNav && h2Elements.length > 0) {
      h2Elements.forEach((h2, index) => {
        const dot = document.createElement('div');
        dot.className = 'chapter-dot' + (index === 0 ? ' active' : '');
        dot.dataset.section = index.toString();
        dot.dataset.label = h2.textContent?.slice(0, 15) || '';

        dot.addEventListener('click', () => {
          h2.scrollIntoView({ behavior: 'smooth' });
        });

        chapterNav.appendChild(dot);
      });

      // Scroll spy
      window.addEventListener('scroll', () => {
        let current = 0;
        h2Elements.forEach((h2, index) => {
          if (window.scrollY >= (h2 as HTMLElement).offsetTop - 300) {
            current = index;
          }
        });

        document.querySelectorAll('.chapter-dot').forEach((dot, index) => {
          dot.classList.toggle('active', index === current);
        });
      });
    }
  });
</script>
