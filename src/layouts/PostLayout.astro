</style>

<script>
  // 著者カード ポップアップ
  document.addEventListener('DOMContentLoaded', () => {
    const authorCard = document.getElementById('author-card');
    const authorPopup = document.getElementById('author-popup');
    const authorPopupClose = document.getElementById('author-popup-close');

    if (authorCard && authorPopup) {
      // カードクリックでポップアップ表示
      authorCard.addEventListener('click', () => {
        authorPopup.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      // 閉じるボタン
      if (authorPopupClose) {
        authorPopupClose.addEventListener('click', (e) => {
          e.stopPropagation();
          authorPopup.classList.remove('active');
          document.body.style.overflow = '';
        });
      }

      // 背景クリックで閉じる
      authorPopup.addEventListener('click', (e) => {
        if (e.target === authorPopup) {
          authorPopup.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // ESCキーで閉じる
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && authorPopup.classList.contains('active')) {
          authorPopup.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    }
  });

  // ================================
  // 🔧 配置デバッグモード（開発用）
  // URLに ?debug=layout を付けると有効
  // ================================
  if (window.location.search.includes('debug=layout')) {
    console.log('🔧 配置デバッグモード ON');
    console.log('📍 ドラッグ: 要素を移動（サイズ固定）');
    console.log('📋 配置が決まったら、「位置をコピー」ボタンでCSS値を取得');

    const banner = document.querySelector('.hero-with-banner');
    if (!banner) {
      console.log('⚠️ バナーが見つかりません（TECHページ以外）');
    } else {
      // 固定スケール値（Aパターンで確定した値）
      const FIXED_SCALES = {
        top: 1.15,
        title: 1.5,
        char: 1.36,
        bottom: 1.37
      };

      // ドラッグ可能にする要素
      const draggables = [
        { el: document.querySelector('.hero-banner-top'), name: 'パンくず＋バッジ', scale: FIXED_SCALES.top },
        { el: document.querySelector('.hero-title-banner'), name: 'タイトル', scale: FIXED_SCALES.title },
        { el: document.querySelector('.character-intro-banner'), name: 'キャラ紹介', scale: FIXED_SCALES.char },
        { el: document.querySelector('.hero-banner-bottom'), name: 'ハッシュタグ', scale: FIXED_SCALES.bottom }
      ];

      const bannerRect = banner.getBoundingClientRect();

      draggables.forEach(({ el, name, scale }) => {
        if (!el) return;

        // スタイル追加（ドラッグ可能を示す）
        el.style.cursor = 'move';
        el.style.outline = '2px dashed #ff00ff';
        el.style.outlineOffset = '2px';
        el.style.position = 'absolute';
        // スケールを固定で維持
        el.style.transform = `scale(${scale})`;
        el.style.transformOrigin = 'top left';

        let isDragging = false;
        let startX, startY, startLeft, startTop;

        // ドラッグのイベント
        el.addEventListener('mousedown', (e) => {
          isDragging = true;
          const rect = el.getBoundingClientRect();
          startX = e.clientX;
          startY = e.clientY;
          // スケール考慮した実際の位置
          startLeft = rect.left - bannerRect.left;
          startTop = rect.top - bannerRect.top;
          e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          const newLeft = startLeft + dx;
          const newTop = startTop + dy;

          // %に変換
          const leftPercent = (newLeft / bannerRect.width * 100).toFixed(1);
          const topPercent = (newTop / bannerRect.height * 100).toFixed(1);

          el.style.left = leftPercent + '%';
          el.style.top = topPercent + '%';
          el.style.bottom = 'auto';
          el.style.right = 'auto';
          // スケールは固定で維持！
          el.style.transform = `scale(${scale})`;
        });

        document.addEventListener('mouseup', () => {
          if (isDragging) {
            const rect = el.getBoundingClientRect();
            const leftPercent = ((rect.left - bannerRect.left) / bannerRect.width * 100).toFixed(1);
            const topPercent = ((rect.top - bannerRect.top) / bannerRect.height * 100).toFixed(1);

            console.log(`\n📍 ${name}:`);
            console.log(`   top: ${topPercent}%; left: ${leftPercent}%;`);

            isDragging = false;
          }
        });
      });

      // 動画パターン情報
      const videoEl = document.querySelector('.hero-banner-video source');
      const currentPattern = videoEl?.getAttribute('src')?.includes('pattern-a') ? 'A' : 'B';

      // 位置調整パネルを追加（パターン切り替え機能付き）
      const controlPanel = document.createElement('div');
      controlPanel.innerHTML = `
        <div style="position: fixed; bottom: 20px; left: 20px; z-index: 99999; background: rgba(0,0,0,0.95); color: #fff; padding: 1rem; border-radius: 8px; border: 2px solid #00ffff; font-size: 12px; width: 300px;">
          <strong style="color: #00ffff; display: block; margin-bottom: 0.75rem;">📍 位置調整パネル</strong>

          <!-- パターン切り替え -->
          <div style="margin-bottom: 1rem; padding: 0.75rem; background: rgba(255,0,255,0.1); border: 1px solid #ff00ff; border-radius: 4px;">
            <span style="color: #ff00ff; font-weight: bold;">🎬 動画パターン切り替え</span>
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
              <button id="switch-pattern-a" style="flex: 1; padding: 0.5rem; background: ${currentPattern === 'A' ? '#ff00ff' : 'rgba(255,255,255,0.1)'}; color: ${currentPattern === 'A' ? '#000' : '#fff'}; border: 1px solid #ff00ff; border-radius: 4px; cursor: pointer; font-weight: bold;">A: ai-journey</button>
              <button id="switch-pattern-b" style="flex: 1; padding: 0.5rem; background: ${currentPattern === 'B' ? '#ff00ff' : 'rgba(255,255,255,0.1)'}; color: ${currentPattern === 'B' ? '#000' : '#fff'}; border: 1px solid #ff00ff; border-radius: 4px; cursor: pointer; font-weight: bold;">B: ai-tips</button>
            </div>
            <p style="color: #888; font-size: 9px; margin-top: 0.5rem; margin-bottom: 0;">現在: パターン<span id="current-pattern">${currentPattern}</span></p>
          </div>

          <p style="color: #888; font-size: 10px; margin-bottom: 0.75rem;">サイズはAパターンで固定済み<br/>ドラッグで位置のみ調整</p>

          <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 4px;">
            <span style="color: #ff6b9d;">パンくず＋バッジ:</span>
            <span style="color: #888; font-size: 10px;"> scale(${FIXED_SCALES.top})</span>
          </div>
          <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 4px;">
            <span style="color: #ffff00;">タイトル:</span>
            <span style="color: #888; font-size: 10px;"> scale(${FIXED_SCALES.title})</span>
          </div>
          <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 4px;">
            <span style="color: #ff6b9d;">キャラカード:</span>
            <span style="color: #888; font-size: 10px;"> scale(${FIXED_SCALES.char})</span>
          </div>
          <div style="margin-bottom: 0.75rem; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 4px;">
            <span style="color: #00ffff;">ハッシュタグ:</span>
            <span style="color: #888; font-size: 10px;"> scale(${FIXED_SCALES.bottom})</span>
          </div>

          <button id="copy-positions" style="width: 100%; padding: 0.5rem; background: #00ffff; color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">📋 位置をコピー</button>
        </div>
      `;
      document.body.appendChild(controlPanel);

      // パターン切り替え処理
      const videoSource = document.querySelector('.hero-banner-video source');
      const video = document.querySelector('.hero-banner-video');
      const btnA = document.getElementById('switch-pattern-a');
      const btnB = document.getElementById('switch-pattern-b');
      const patternLabel = document.getElementById('current-pattern');

      const switchPattern = (pattern) => {
        const src = pattern === 'A'
          ? '/images/tech/hero-patterns/pattern-a-journey.mp4'
          : '/images/tech/hero-patterns/pattern-b-tips.mp4';

        if (videoSource) {
          videoSource.setAttribute('src', src);
          video.load();
          video.play();
        }

        // data-pattern属性を更新（CSSスタイル切り替え用）
        banner.setAttribute('data-pattern', pattern);

        // ボタンスタイル更新
        btnA.style.background = pattern === 'A' ? '#ff00ff' : 'rgba(255,255,255,0.1)';
        btnA.style.color = pattern === 'A' ? '#000' : '#fff';
        btnB.style.background = pattern === 'B' ? '#ff00ff' : 'rgba(255,255,255,0.1)';
        btnB.style.color = pattern === 'B' ? '#000' : '#fff';
        patternLabel.textContent = pattern;

        console.log(`🎬 パターン${pattern}に切り替えました`);
      };

      btnA?.addEventListener('click', () => switchPattern('A'));
      btnB?.addEventListener('click', () => switchPattern('B'));

      const topEl = document.querySelector('.hero-banner-top');
      const titleEl = document.querySelector('.hero-title-banner');
      const charEl = document.querySelector('.character-intro-banner');
      const bottomEl = document.querySelector('.hero-banner-bottom');

      // CSS値をコピー（位置のみ、サイズは固定値）
      document.getElementById('copy-positions').addEventListener('click', () => {
        const getPos = (el) => {
          if (!el) return { top: 0, left: 0 };
          const rect = el.getBoundingClientRect();
          const bannerRect = banner.getBoundingClientRect();
          return {
            top: ((rect.top - bannerRect.top) / bannerRect.height * 100).toFixed(1),
            left: ((rect.left - bannerRect.left) / bannerRect.width * 100).toFixed(1)
          };
        };

        const topPos = getPos(topEl);
        const titlePos = getPos(titleEl);
        const charPos = getPos(charEl);
        const bottomPos = getPos(bottomEl);

        const css = `
/* パンくず＋バッジ */
.hero-banner-top { top: ${topPos.top}%; left: ${topPos.left}%; }

/* タイトル */
.hero-title-banner { top: ${titlePos.top}%; left: ${titlePos.left}%; }

/* キャラ紹介カード */
.character-intro-banner { top: ${charPos.top}%; left: ${charPos.left}%; }

/* ハッシュタグ */
.hero-banner-bottom { top: ${bottomPos.top}%; left: ${bottomPos.left}%; }
`;
        navigator.clipboard.writeText(css).then(() => {
          alert('位置をクリップボードにコピーしました！');
          console.log('📋 コピーした位置:\n' + css);
        });
      });

      // 使い方ガイドを画面に表示
      const guide = document.createElement('div');
      guide.innerHTML = `
        <div style="position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 99999; background: rgba(0,0,0,0.9); color: #fff; padding: 1rem 2rem; border-radius: 8px; border: 2px solid #ff00ff; font-size: 14px; text-align: center;">
          <strong style="color: #ff00ff;">🔧 位置調整モード</strong><br/>
          <span style="color: #00ffff;">ドラッグで位置のみ調整（サイズ固定）</span><br/>
          <small style="color: #888;">パネルでA/B切り替え可能</small>
        </div>
      `;
      document.body.appendChild(guide);
    }

    // フッターバナーのデバッグ
    const footerBanner = document.querySelector('.footer-banner');
    if (footerBanner) {
      console.log('🎬 フッターバナー デバッグ ON');

      // フッター用デバッグパネル
      const footerDebugPanel = document.createElement('div');
      footerDebugPanel.innerHTML = `
        <div style="position: fixed; bottom: 20px; right: 20px; z-index: 99999; background: rgba(0,0,0,0.95); color: #fff; padding: 1rem; border-radius: 8px; border: 2px solid #ff6b9d; font-size: 12px; width: 280px;">
          <strong style="color: #ff6b9d; display: block; margin-bottom: 0.75rem;">🎬 フッターバナー調整</strong>

          <div style="margin-bottom: 0.75rem;">
            <label style="color: #888; font-size: 10px; display: block; margin-bottom: 0.25rem;">ドットフィルター高さ</label>
            <input type="range" id="footer-dot-height" min="30" max="100" value="60" style="width: 100%;" />
            <span id="footer-dot-height-val" style="color: #00ffff; font-size: 11px;">60%</span>
          </div>

          <div style="margin-bottom: 0.75rem;">
            <label style="color: #888; font-size: 10px; display: block; margin-bottom: 0.25rem;">ドット濃さ</label>
            <input type="range" id="footer-dot-opacity" min="20" max="100" value="40" style="width: 100%;" />
            <span id="footer-dot-opacity-val" style="color: #00ffff; font-size: 11px;">0.4</span>
          </div>

          <div style="margin-bottom: 0.75rem;">
            <label style="color: #888; font-size: 10px; display: block; margin-bottom: 0.25rem;">背景グラデ濃さ</label>
            <input type="range" id="footer-bg-opacity" min="40" max="100" value="85" style="width: 100%;" />
            <span id="footer-bg-opacity-val" style="color: #00ffff; font-size: 11px;">0.85</span>
          </div>

          <button id="footer-copy-css" style="width: 100%; padding: 0.5rem; background: #ff6b9d; color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">📋 CSSをコピー</button>
        </div>
      `;
      document.body.appendChild(footerDebugPanel);

      const dotFilter = document.querySelector('.footer-dot-filter');
      const heightSlider = document.getElementById('footer-dot-height');
      const opacitySlider = document.getElementById('footer-dot-opacity');
      const bgOpacitySlider = document.getElementById('footer-bg-opacity');
      const heightVal = document.getElementById('footer-dot-height-val');
      const opacityVal = document.getElementById('footer-dot-opacity-val');
      const bgOpacityVal = document.getElementById('footer-bg-opacity-val');

      const updateDotFilter = () => {
        const h = heightSlider.value;
        const o = opacitySlider.value / 100;
        const bg = bgOpacitySlider.value / 100;

        heightVal.textContent = h + '%';
        opacityVal.textContent = o.toFixed(2);
        bgOpacityVal.textContent = bg.toFixed(2);

        dotFilter.style.height = h + '%';
        dotFilter.style.background = `
          radial-gradient(circle at center, rgba(0, 0, 0, ${o}) 1px, transparent 1px),
          linear-gradient(to top, rgba(0, 0, 0, ${bg}) 0%, rgba(0, 0, 0, ${bg * 0.7}) 40%, transparent 100%)
        `;
      };

      heightSlider?.addEventListener('input', updateDotFilter);
      opacitySlider?.addEventListener('input', updateDotFilter);
      bgOpacitySlider?.addEventListener('input', updateDotFilter);

      document.getElementById('footer-copy-css')?.addEventListener('click', () => {
        const h = heightSlider.value;
        const o = opacitySlider.value / 100;
        const bg = bgOpacitySlider.value / 100;

        const css = `
.footer-dot-filter {
  height: ${h}%;
  background:
    radial-gradient(circle at center, rgba(0, 0, 0, ${o}) 1px, transparent 1px),
    linear-gradient(to top, rgba(0, 0, 0, ${bg}) 0%, rgba(0, 0, 0, ${(bg * 0.7).toFixed(2)}) 40%, transparent 100%);
  background-size: 4px 4px, 100% 100%;
}`;
        navigator.clipboard.writeText(css).then(() => {
          alert('フッターCSSをコピーしました！');
          console.log('📋 フッターCSS:\n' + css);
        });
      });
    }
  }

  // ================================
  // TRANSMIT ボタン機能
  // ================================
  document.addEventListener('DOMContentLoaded', () => {
    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent(document.title);

    // X (Twitter) シェア
    const shareX = document.getElementById('share-x');
    if (shareX) {
      shareX.href = `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`;
      shareX.target = '_blank';
      shareX.rel = 'noopener noreferrer';
    }

    // Facebook シェア
    const shareFb = document.getElementById('share-fb');
    if (shareFb) {
      shareFb.href = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
      shareFb.target = '_blank';
      shareFb.rel = 'noopener noreferrer';
    }

    // リンクをコピー
    const copyLink = document.getElementById('copy-link');
    if (copyLink) {
      copyLink.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          // コピー成功フィードバック
          const span = copyLink.querySelector('span');
          const originalText = span.textContent;
          span.textContent = 'COPIED!';
          copyLink.style.color = '#00ffff';
          copyLink.style.borderColor = 'rgba(0, 255, 255, 0.5)';
          setTimeout(() => {
            span.textContent = originalText;
            copyLink.style.color = '';
            copyLink.style.borderColor = '';
          }, 2000);
        } catch (err) {
          console.error('コピーに失敗しました:', err);
        }
      });
    }
  });
</script>
