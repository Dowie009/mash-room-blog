        <div id="debug-tags-pos">📍 Tags: --</div>
        <hr style="border-color:#333;margin:10px 0;">
        <div style="font-size:10px;color:#888;">※ 位置が決まったらCSSに反映してください</div>
        <button id="debug-copy-css" style="margin-top:10px;padding:8px 12px;background:#0f0;color:#000;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">📋 CSS をコピー</button>
      </div>
    `;
    document.body.appendChild(panel);

    // ドラッグ対象の要素
    const tagsEl = document.querySelector('.hero-tags-banner');

    // 要素をドラッグ可能にする関数
    function makeDraggable(el, name, displayId) {
      if (!el) return;

      // スタイルを調整
      el.style.position = 'absolute';
      el.style.cursor = 'move';
      el.style.outline = '3px dashed #0f0';
      el.style.outlineOffset = '2px';
      el.style.zIndex = '9999';

      let isDragging = false;
      let startX, startY, startLeft, startTop;

      el.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = el.getBoundingClientRect();
        const parentRect = el.offsetParent.getBoundingClientRect();
        startLeft = rect.left - parentRect.left;
        startTop = rect.top - parentRect.top;
        e.preventDefault();
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        const newLeft = startLeft + dx;
        const newTop = startTop + dy;
        el.style.left = newLeft + 'px';
        el.style.top = newTop + 'px';
        document.getElementById(displayId).textContent =
          `📍 ${name}: top: ${Math.round(newTop)}px; left: ${Math.round(newLeft)}px;`;
      });

      document.addEventListener('mouseup', () => {
        isDragging = false;
      });

      // 初期位置を表示
      setTimeout(() => {
        const rect = el.getBoundingClientRect();
        const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0 };
        const left = rect.left - parentRect.left;
        const top = rect.top - parentRect.top;
        document.getElementById(displayId).textContent =
          `📍 ${name}: top: ${Math.round(top)}px; left: ${Math.round(left)}px;`;
      }, 500);
    }

    // タグは幅を固定して1行に保つ
    if (tagsEl) {
      tagsEl.style.width = 'max-content';
      tagsEl.style.minWidth = '600px';
    }
    makeDraggable(tagsEl, 'Tags', 'debug-tags-pos');

    // CSSコピーボタン
    document.getElementById('debug-copy-css').addEventListener('click', () => {
      const tagsText = document.getElementById('debug-tags-pos').textContent;

      const tagsMatch = tagsText.match(/top: (-?\d+)px; left: (-?\d+)px/);

      let css = '/* 調整後の位置 */\n\n';
      if (tagsMatch) {
        css += `.hero-tags-banner {\n  position: absolute;\n  top: ${tagsMatch[1]}px;\n  left: ${tagsMatch[2]}px;\n}\n`;
      }

      navigator.clipboard.writeText(css).then(() => {
        alert('CSSをクリップボードにコピーしました！');
      });
    });
  });
})();
</script>


