---
/**
 * PostLayout.astro - 記事ページ専用レイアウト
 *
 * サイバー/ダークテーマ - あいぼーとの会話形式に最適化
 */
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    category: string;
    description?: string;
    tags?: string[];
    thumbnail?: string;
    learningLevel?: number;
    topic?: string;
    learnings?: string[];
    defaultPreset?: number;
    defaultBgEffect?: 'none' | 'grid' | 'dots' | 'mesh';
  };
  collection?: 'tech' | 'gear' | 'story' | 'ai';
}

const { frontmatter, collection = 'tech' } = Astro.props;

// 日付フォーマット
const formatDate = (date: Date) => {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// カテゴリ表示名とカラー
const categoryConfig: Record<string, { label: string; color: string }> = {
  // TECH（2カテゴリのみ）
  'ai-journey': { label: 'AI JOURNEY', color: '#00ffff' },
  'ai-tips': { label: 'AI TIPS', color: '#ffaa00' },
  // GEAR
  daw: { label: 'DAW', color: '#8b5cf6' },
  gear: { label: 'GEAR', color: '#ef4444' },
  plugin: { label: 'PLUGIN', color: '#06b6d4' },
  biz: { label: 'BIZ', color: '#f59e0b' },
  tips: { label: 'TIPS', color: '#84cc16' },
  essay: { label: 'ESSAY', color: '#ec4899' },
  // STORY
  story: { label: 'STORY', color: '#a855f7' },
  diary: { label: 'DIARY', color: '#f472b6' },
  review: { label: 'REVIEW', color: '#14b8a6' },
};

// コレクションごとの設定
const collectionConfig: Record<string, { href: string; label: string; gradient: string; icon: string }> = {
  tech: {
    href: '/tech',
    label: 'TECH LAB',
    gradient: 'linear-gradient(135deg, #06b6d4, #3b82f6)',
    icon: '⚡'
  },
  gear: {
    href: '/gear',
    label: 'GEAR LAB',
    gradient: 'linear-gradient(135deg, #f97316, #ef4444)',
    icon: '🎛️'
  },
  story: {
    href: '/story',
    label: 'STORY LAB',
    gradient: 'linear-gradient(135deg, #a855f7, #ec4899)',
    icon: '📖'
  },
};

const config = collectionConfig[collection] || collectionConfig.tech;
const catConfig = categoryConfig[frontmatter.category] || { label: frontmatter.category.toUpperCase(), color: '#888' };

// ヒーローバナー動画パターン設定
// A: ai-journey (宇宙背景)
// B: ai-tips (その他TECH記事用)
// C: 静止画版 (バックアップ - PostLayout-C-static.astro.backup)
const heroPatternConfig: Record<string, { video: string; label: string }> = {
  'ai-journey': { video: '/images/tech/hero-patterns/pattern-a-journey.mp4', label: 'A' },
  'ai-tips': { video: '/images/tech/hero-patterns/pattern-b-tips.mp4', label: 'B' },
  // デフォルト（その他のTECHカテゴリ）はBパターンを使用
};
const heroPattern = heroPatternConfig[frontmatter.category] || heroPatternConfig['ai-tips'];

// フッターバナー動画パターン設定
// A: ai-journey用フッター
// B: その他TECH記事用フッター
const footerPatternConfig: Record<string, string> = {
  'ai-journey': '/images/tech/hero-patterns/Aパターンのフッター.mp4',
  'default': '/images/tech/hero-patterns/footer-pattern-b.V2.mp4',
};
const footerPattern = footerPatternConfig[frontmatter.category] || footerPatternConfig['default'];

// 前後記事を自動取得（TECHコレクション用）
let prevPost: { slug: string; title: string } | null = null;
let nextPost: { slug: string; title: string } | null = null;

if (collection === 'tech') {
  const allPosts = await getCollection('tech', ({ data }) => !data.draft);
  // 日付順でソート（新しい順）
  const sortedPosts = allPosts.sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  // 現在の記事のslugを取得（URLから）
  const currentSlug = Astro.url.pathname.split('/').pop();
  const currentIndex = sortedPosts.findIndex(post => post.slug === currentSlug);

  if (currentIndex !== -1) {
    // 前の記事（より新しい記事）
    if (currentIndex > 0) {
      const prev = sortedPosts[currentIndex - 1];
      prevPost = { slug: prev.slug, title: prev.data.title };
    }
    // 次の記事（より古い記事）
    if (currentIndex < sortedPosts.length - 1) {
      const next = sortedPosts[currentIndex + 1];
      nextPost = { slug: next.slug, title: next.data.title };
    }
  }
}

// 読了時間を計算（仮で5分）
const readTime = '5 min read';

// Learning Level表示
const levelLabels = ['', '入門', '基礎', '実践', '応用', '発展'];
const levelLabel = frontmatter.learningLevel ? levelLabels[frontmatter.learningLevel] : null;

// 関連記事用：最新記事リスト（現在の記事を除く、最大5件）
let recentPosts: Array<{ slug: string; title: string; date: Date; thumbnail?: string }> = [];
// 人気記事用：仮でランダムに5件選出（将来的にはアクセス数等で並び替え）
let popularPosts: Array<{ slug: string; title: string; date: Date; thumbnail?: string }> = [];

if (collection === 'tech') {
  const allPosts = await getCollection('tech', ({ data }) => !data.draft);
  const currentSlug = Astro.url.pathname.split('/').pop();
  const filteredPosts = allPosts.filter(post => post.slug !== currentSlug);

  // 新着記事（日付順）
  recentPosts = filteredPosts
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 5)
    .map(post => ({
      slug: post.slug,
      title: post.data.title,
      date: post.data.date,
      thumbnail: post.data.thumbnail
    }));

  // 人気記事（仮：日付逆順で違う記事を表示）
  popularPosts = filteredPosts
    .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
    .slice(0, 5)
    .map(post => ({
      slug: post.slug,
      title: post.data.title,
      date: post.data.date,
      thumbnail: post.data.thumbnail
    }));
}
---

<Layout title={`${frontmatter.title} | ${config.label}`}>
  <div class="post-page" data-category={frontmatter.category} data-default-preset={frontmatter.defaultPreset || 1} data-default-bg-effect={frontmatter.defaultBgEffect || 'none'}>
    <!-- 裏モード用：動画背景（デフォルト非表示） -->
    <div class="video-bg-container" id="video-bg-container" style="display: none;">
      <video autoplay muted loop playsinline class="video-bg" id="video-bg">
        <source src="/images/カオス背景.mp4" type="video/mp4" />
      </video>
      <div class="video-bg-overlay"></div>
    </div>

    <!-- Tech記事用テクスチャ背景 -->
    {collection === 'tech' && (
      <div class="tech-texture-bg"></div>
    )}

    <!-- 3層サイバー背景 -->
    <div class="cyber-overlay"></div>
    <div class="cyber-particles"></div>

    <!-- 背景エフェクトレイヤー -->
    <div class="bg-effect-layer" id="bg-effect-grid"></div>
    <div class="bg-effect-layer" id="bg-effect-dots"></div>
    <div class="bg-effect-layer bg-effect-mesh" id="bg-effect-mesh"></div>

    <!-- パンくずリストバー（PANDORA風・ヘッダー下固定） -->
    <nav class="breadcrumb-bar">
      <div class="breadcrumb-bar-inner">
        <a href="/" class="breadcrumb-bar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>HOME</span>
        </a>
        <span class="breadcrumb-bar-sep">›</span>
        <a href={config.href} class="breadcrumb-bar-link">{config.label}</a>
        <span class="breadcrumb-bar-sep">›</span>
        <span class="breadcrumb-bar-current" style={`--cat-color: ${catConfig.color}`}>{catConfig.label}</span>
        <span class="breadcrumb-bar-sep">›</span>
        <span class="breadcrumb-bar-title">{frontmatter.title}</span>
      </div>
    </nav>

    <!-- ヒーローセクション（TECHページ用：動画バナー - カテゴリ別自動切り替え） -->
    {collection === 'tech' ? (
      <header class="hero-with-banner" data-pattern={heroPattern.label}>
        <div class="hero-video-container">
          <video autoplay muted loop playsinline class="hero-banner-video">
            <source src={heroPattern.video} type="video/mp4" />
          </video>
        </div>
        <div class="hero-banner-overlay">
          <div class="hero-banner-content">
            <!-- 上部左：パンくず（大きく・水色グロー） -->
            <div class="hero-banner-top">
              <nav class="breadcrumb breadcrumb-banner">
                <a href="/" class="breadcrumb-link">HOME</a>
                <span class="breadcrumb-sep">/</span>
                <a href={config.href} class="breadcrumb-link">{config.label}</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-current">{catConfig.label}</span>
              </nav>
              <div class="hero-meta-banner">
                <span class="category-badge category-badge-banner" style={`--cat-color: ${catConfig.color}`}>
                  {catConfig.label}
                </span>
                {levelLabel && (
                  <span class="level-badge level-badge-banner">
                    <span class="level-icon">Lv.{frontmatter.learningLevel}</span>
                    <span class="level-text">{levelLabel}</span>
                  </span>
                )}
              </div>
            </div>

            <!-- 中央：キャラクター紹介カード（バナー内・黄色エリア） -->
            {frontmatter.category === 'ai-journey' && (
              <div class="character-intro-banner">
                <div class="character-banner">
                  <div class="character-avatar-banner aibou">🤖</div>
                  <div class="character-info-banner">
                    <span class="character-name-banner">あいぼー</span>
                    <span class="character-role-banner">関西弁AI・ナビゲーター</span>
                  </div>
                </div>
                <span class="character-x-banner">×</span>
                <div class="character-banner">
                  <div class="character-avatar-banner michi">
                    <img src="/images/tech/mashiba-profile.jpg" alt="道ゐ" />
                  </div>
                  <div class="character-info-banner">
                    <span class="character-name-banner">道ゐ</span>
                    <span class="character-role-banner">真柴道ゐ・語り手</span>
                  </div>
                </div>
              </div>
            )}

            <!-- タイトル（バナー内） -->
            <h1 class="hero-title-banner">{frontmatter.title}</h1>

            <!-- ピンクバー上：ハッシュタグ（水色グロー） -->
            <div class="hero-banner-bottom">
              {frontmatter.tags && frontmatter.tags.length > 0 && (
                <div class="hero-tags hero-tags-banner">
                  {frontmatter.tags.map(tag => (
                    <span class="tag tag-banner">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </header>
    ) : (
      <header class="hero">
        <div class="hero-content">
          <nav class="breadcrumb">
            <a href="/" class="breadcrumb-link">HOME</a>
            <span class="breadcrumb-sep">/</span>
            <a href={config.href} class="breadcrumb-link">{config.label}</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">{catConfig.label}</span>
          </nav>

          <div class="hero-meta">
            <span class="category-badge" style={`--cat-color: ${catConfig.color}`}>
              {catConfig.label}
            </span>
            {levelLabel && (
              <span class="level-badge">
                <span class="level-icon">Lv.{frontmatter.learningLevel}</span>
                <span class="level-text">{levelLabel}</span>
              </span>
            )}
            <div class="meta-info">
              <time datetime={frontmatter.date.toISOString()}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formatDate(frontmatter.date)}
              </time>
              <span class="read-time">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {readTime}
              </span>
            </div>
          </div>

          <h1 class="hero-title">{frontmatter.title}</h1>

          {frontmatter.description && (
            <p class="hero-description">{frontmatter.description}</p>
          )}

          {frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="hero-tags">
              {frontmatter.tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>
    )}

    <!-- 本文 -->
    <main class="article-main">
      <!-- モバイル/狭い画面用のボタンバー -->
      <div class="mobile-toolbar" id="mobile-toolbar">
        <button class="mobile-btn customize-mobile" id="customize-btn-mobile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>CUSTOMIZE</span>
        </button>
        {frontmatter.learnings && frontmatter.learnings.length > 0 && (
          <button class="mobile-btn learnings-mobile" id="learnings-btn-mobile">
            <span>📚</span>
            <span>LEARNINGS</span>
          </button>
        )}
        <button class="mobile-btn transmit-mobile" id="transmit-btn-mobile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span>TRANSMIT</span>
        </button>
      </div>

      <!-- モバイル用LEARNINGSドロップダウン -->
      {frontmatter.learnings && frontmatter.learnings.length > 0 && (
        <div class="mobile-learnings-dropdown" id="mobile-learnings-dropdown" style="display: none;">
          <ul class="mobile-learnings-list">
            {frontmatter.learnings.map((item, index) => (
              <li>
                <a href={`#learning-${index + 1}`} class="mobile-learnings-link">
                  <span class="mobile-learnings-number">{index + 1}</span>
                  <span>{item}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- モバイル用TRANSMITドロップダウン -->
      <div class="mobile-transmit-dropdown" id="mobile-transmit-dropdown" style="display: none;">
        <div class="mobile-transmit-buttons">
          <a href="#" class="mobile-transmit-btn" id="share-x-mobile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>POST</span>
          </a>
          <a href="#" class="mobile-transmit-btn" id="share-fb-mobile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>SHARE</span>
          </a>
          <button class="mobile-transmit-btn" id="copy-link-mobile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>COPY</span>
          </button>
        </div>
      </div>

      <article id="article-container" class="article-content">
        <slot />
      </article>

      <!-- 中央スペース（スタイル編集パネル用） -->
      <div class="style-panel-space">
        <!-- ===== STYLE SWITCHER パネル ===== -->
        <div id="global-style-switcher" class="style-switcher-panel" style="display: none;">
          <div class="switcher-header">
            <span class="switcher-title">🎨 スタイル調整</span>
            <button class="switcher-close" id="switcher-close">✕</button>
          </div>

          <!-- おすすめプリセット -->
          <div class="switcher-section">
            <div class="switcher-label">✨ おすすめプリセット</div>
            <div class="preset-buttons">
              <button class="preset-btn preset-1" data-preset="1" title="サイバーダーク">1</button>
              <button class="preset-btn preset-2" data-preset="2" title="ギャラクシー">2</button>
              <button class="preset-btn preset-3" data-preset="3" title="オーロラ">3</button>
              <button class="preset-btn preset-4" data-preset="4" title="さくら">4</button>
              <button class="preset-btn preset-5" data-preset="5" title="クリーンライト">5</button>
            </div>
            <div class="preset-scale">
              <span>← 暗</span>
              <span>明 →</span>
            </div>
          </div>

          <!-- 裏モード（動画背景） -->
          <div class="switcher-section">
            <div class="switcher-label">🎬 裏モード</div>
            <button class="ura-mode-btn" id="ura-mode-btn">動画背景 ON/OFF</button>
          </div>

          <!-- フォント切り替え -->
          <div class="switcher-section">
            <div class="switcher-label">🔤 フォント</div>
            <div class="font-buttons">
              <button class="font-btn" data-font="noto">ゴシック</button>
              <button class="font-btn" data-font="maru">まるご</button>
              <button class="font-btn" data-font="mincho">明朝</button>
            </div>
            <div class="font-buttons" style="margin-top: 0.25rem;">
              <button class="font-btn" data-font="klee">手書き</button>
              <button class="font-btn" data-font="sawarabi">さわらび</button>
            </div>
          </div>

          <!-- ズーム -->
          <div class="switcher-section">
            <div class="switcher-label">🔍 ズーム</div>
            <div class="zoom-controls">
              <button class="zoom-btn" id="zoom-minus">−</button>
              <span class="zoom-level" id="zoom-level">100%</span>
              <button class="zoom-btn" id="zoom-plus">+</button>
              <button class="zoom-reset" id="zoom-reset">リセット</button>
            </div>
          </div>

          <!-- 背景ベース -->
          <div class="switcher-section">
            <div class="switcher-label">🌙 背景ベース</div>
            <div class="bg-buttons">
              <button class="bg-btn" data-bg="black">黒</button>
              <button class="bg-btn" data-bg="navy">紺</button>
              <button class="bg-btn" data-bg="gray">灰</button>
              <button class="bg-btn" data-bg="lightgray">淡灰</button>
              <button class="bg-btn" data-bg="white">白</button>
            </div>
          </div>

          <!-- 背景エフェクト（網を選ぶとグロー+スクロール連動が自動ON） -->
          <div class="switcher-section">
            <div class="switcher-label">✨ 背景エフェクト</div>
            <div class="effect-buttons">
              <button class="effect-btn" data-effect="none" title="なし">×</button>
              <button class="effect-btn" data-effect="grid" title="グリッド">格</button>
              <button class="effect-btn" data-effect="dots" title="ドット">点</button>
              <button class="effect-btn effect-mesh" data-effect="mesh" title="グロー+メッシュ（スクロール連動）">網</button>
            </div>
          </div>

          <!-- 吹き出しスタイル -->
          <div class="switcher-section">
            <div class="switcher-label">💬 吹き出し</div>
            <div class="bubble-buttons">
              <button class="bubble-btn" data-bubble="glass">ガラス</button>
              <button class="bubble-btn" data-bubble="solid">白</button>
              <button class="bubble-btn" data-bubble="dark">黒</button>
              <button class="bubble-btn" data-bubble="pastel">淡</button>
