  };

  // ================================
  // 背景スタイル（5段階：暗→明）
  // ================================
  const baseBgStyles = {
    black: { bg: '#0a0a0a', textColor: '#ffffff' },      // 1: 黒め → 白文字
    navy: { bg: '#1a1a2e', textColor: '#ffffff' },       // 2: ネイビー → 白文字
    gray: { bg: '#3a3a3a', textColor: '#e0e0e0' },       // 3: グレー → 明るいグレー文字
    lightgray: { bg: '#888888', textColor: '#1a1a1a' },  // 4: 明るいグレー → 濃い文字
