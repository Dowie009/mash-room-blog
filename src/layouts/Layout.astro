---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  version?: string;
  canonicalUrl?: string;
}

const SITE_URL = 'https://mashroom-studio.com';
const DEFAULT_OG_IMAGE = '/images/og-default.png';

const {
  title = 'きのこ式AI栽培日記 | MASHROOM STUDIO',
  description = 'クリエイターのためのAI活用術。TECH LAB・GEAR LAB・STORY LABの3つの研究室から、AI時代のものづくりを発信します。',
  ogImage = DEFAULT_OG_IMAGE,
  version,
  canonicalUrl
} = Astro.props;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Favicon */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff4d00" />

    <meta name="generator" content={Astro.generator} />

    {/* OGP (Open Graph Protocol) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="きのこ式AI栽培日記" />
    <meta property="og:locale" content="ja_JP" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    
    {/* SEO: 検索エンジンにインデックスを許可 */}
    <meta name="robots" content="index, follow" />

    {/* Google Search Console 所有権確認 */}
    <meta name="google-site-verification" content="CP_OxlFTyh0dbJ_dGCijthvvJGZ2di0Xoo95hs72xfY" />
    <meta name="google-site-verification" content="GhWxcV-k_Xc5tK2vmxKPDXeEp3tjh9vMwH1-dijW_cg" />
    
    {/* バージョン情報（指定がある場合のみ） */}
    {version && (
      <>
        <meta name="version" content={version} />
        <meta name="last-modified" content={new Date().toISOString()} />
      </>
    )}
    
    {/* Canonical URL（指定がある場合のみ） */}
    {canonicalUrl && (
      <link rel="canonical" href={canonicalUrl} />
    )}
    
    <title>{title}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@700;900&family=Zen+Maru+Gothic:wght@400;500;700&family=Space+Grotesk:wght@300;500;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Klee+One:wght@400;600&family=Sawarabi+Gothic&display=swap" rel="stylesheet" />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PYXBH0H9ZL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PYXBH0H9ZL');
    </script>
  </head>
  <body>
    <slot />
    
    <!-- Scripts: Load at end of body to ensure DOM is ready -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline>
      // セクション識別バッジ: ローカル開発時 or ?badge 付きURLでのみ表示
      if (location.hostname === 'localhost' || location.search.indexOf('badge') !== -1) {
        document.documentElement.classList.add('show-badges');
      }
    </script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollToPlugin.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/Flip.min.js"></script>
    <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #050505;
    --text-color: #e0e0e0;
    --accent-color: #ff4d00;
  }

  html {
    font-family: 'Noto Sans JP', sans-serif;
    background: var(--bg-color);
  }
  
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  /* --- セクション識別バッジ ---
     修正指示・フィードバック用の目印。各セクションの左下に表示。
     ローカル開発時と ?badge 付きURLでのみ表示（本番では非表示）。 */
  .section-badge {
    display: none;
  }
  html.show-badges .section-badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 900;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'Space Grotesk', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 77, 0, 0.55);
    border-radius: 3px;
    padding: 3px 9px;
    pointer-events: none;
    backdrop-filter: blur(4px);
  }
  .section-badge b {
    color: var(--accent-color, #ff4d00);
    font-weight: 700;
  }

  /* --- スクロール連動エッジライト ---
     スクロールの勢い（--scroll-glow、トップページのrafループが毎フレーム更新）に
     反応して画面の上下端がほのかに光る。どのセクションにいても
     「スクロール入力が効いている」ことが視覚的に伝わる保険レイヤー。
     変数が更新されないページ（記事ページ等）では常に透明のまま。 */
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9990;
    background:
      radial-gradient(120% 45% at 50% -12%, rgba(255, 77, 0, 0.22), transparent 62%),
      radial-gradient(120% 45% at 50% 112%, rgba(255, 77, 0, 0.22), transparent 62%);
    opacity: var(--scroll-glow, 0);
    will-change: opacity;
  }

  .font-mincho { 
    font-family: 'Zen Old Mincho', serif; 
  }
  
  .font-tech { 
    font-family: 'Space Grotesk', sans-serif; 
  }

  /* --- UI: FLOOR GUIDE --- */
  .floor-link {
    cursor: pointer;
    transition: color 0.3s, opacity 0.3s;
    opacity: 0.5;
    display: block;
    font-size: 14px;
    margin-bottom: 4px;
  }
  .floor-link:hover { opacity: 1; }
  .floor-link.active {
    opacity: 1;
    color: var(--accent-color);
    font-weight: bold;
    text-shadow: 0 0 10px rgba(255, 77, 0, 0.5);
    font-size: 16px;
  }

  /* --- UI: ENERGY BAR --- */
  .energy-bar-container {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 90;
    display: none; /* Shown via JS in specific section */
  }
  .energy-bar-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: var(--accent-color);
    box-shadow: 0 0 15px var(--accent-color);
    transition: height 0.1s linear;
  }
  .energy-label {
    position: absolute;
    bottom: 20px;
    right: 15px;
    transform-origin: right bottom;
    transform: rotate(-90deg);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    color: var(--accent-color);
    letter-spacing: 0.2em;
    white-space: nowrap;
  }

  /* View Transitions の設定 */
  @view-transition {
    navigation: auto;
  }

  /* 音楽プレイヤーの永続化 */
  [data-astro-transition-persist] {
    view-transition-name: audio-player;
  }
</style>
